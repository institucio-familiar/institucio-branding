{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "paths": {
      "@root/*": ["./*"],
      "@src/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@layouts/*": ["./src/layouts/*"],
      // "@images/*": ["./src/assets/images/*"],
      // "@pages/*": ["./src/pages/*"],
      "@scripts/*": ["./src/scripts/*"]
      // "@styles/*": ["./src/styles/*"],
      // "@templates/*": ["./src/templates/*"],
      // "@types/*": ["types/*"],
      // "@data/*": ["./src/data/*"]
    }
  }
}
