---
import maskShape4o from '@/assets/svgs/mask_shape_4o.svg'
import maskShapeTibo from '@/assets/svgs/mask_shape_tibo.svg'

type MaskType = '4o' | 'tibo'

interface Props {
  type: MaskType
  class?: string
  border?: boolean
}

const masks: Record<MaskType, { src: string; aspectClass: string }> = {
  '4o': { src: maskShape4o.src, aspectClass: 'aspect-square' },
  tibo: { src: maskShapeTibo.src, aspectClass: 'aspect-[103/111]' }
}

const { type, class: className, border = false } = Astro.props
const mask = masks[type]
const maskStyle = `--mask-image: url(${mask.src})`
---

<div
  class:list={[
    'relative w-full max-w-[480px]',
    mask.aspectClass,
    !border && 'mask',
    className
  ]}
  style={!border ? maskStyle : undefined}
>
  {
    border && (
      <div
        class="mask bg-ink absolute inset-0"
        style={maskStyle}
        aria-hidden="true"
      />
    )
  }
  <div
    class:list={['absolute inset-0', border && ['mask', 'inset-px']]}
    style={border ? maskStyle : undefined}
  >
    <div class="absolute inset-0">
      <slot />
    </div>
  </div>
</div>

<style>
  .mask {
    mask-image: var(--mask-image);
    -webkit-mask-image: var(--mask-image);
    mask-size: contain;
    -webkit-mask-size: contain;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-position: center;
  }
</style>
