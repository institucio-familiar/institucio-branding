---
import mask4o from '@/assets/svgs/mask_4o.svg'
import maskTibo from '@/assets/svgs/mask_tibo.svg'
import maskTiboSquare from '@/assets/svgs/mask_tibo_square.svg'
import maskTiboHorizontal from '@/assets/svgs/mask_tibo_horizontal.svg'
import maskTobiHorizontal from '@/assets/svgs/mask_tobi_horizontal.svg'
import maskTobo from '@/assets/svgs/mask_tobo.svg'
import maskToboHorizontal from '@/assets/svgs/mask_tobo_horizontal.svg'
import maskTobobo from '@/assets/svgs/mask_tobobo.svg'
import maskHomeLeft from '@/assets/svgs/mask_home_left.svg'
import maskHomeRight from '@/assets/svgs/mask_home_right.svg'

type MaskType =
  | '4o'
  | 'tibo'
  | 'tibo_square'
  | 'tibo_horizontal'
  | 'tobi_horizontal'
  | 'tobo'
  | 'tobo_horizontal'
  | 'tobobo'
  | 'home_left'
  | 'home_right'
interface Props {
  type: MaskType
  class?: string
  border?: boolean
}

const masks: Record<MaskType, { src: string; aspectClass: string }> = {
  '4o': { src: mask4o.src, aspectClass: 'aspect-square' },
  tibo: { src: maskTibo.src, aspectClass: 'aspect-[273.27/345]' },
  tibo_square: { src: maskTiboSquare.src, aspectClass: 'aspect-square' },
  tibo_horizontal: {
    src: maskTiboHorizontal.src,
    aspectClass: 'aspect-[1297/854]'
  },
  tobi_horizontal: {
    src: maskTobiHorizontal.src,
    aspectClass: 'aspect-[1297/854]'
  },
  tobo: { src: maskTobo.src, aspectClass: 'aspect-[576.51/719.98]' },
  tobo_horizontal: {
    src: maskToboHorizontal.src,
    aspectClass: 'aspect-[1297/854]'
  },
  tobobo: { src: maskTobobo.src, aspectClass: 'aspect-[576.52/364.45]' },
  home_left: { src: maskHomeLeft.src, aspectClass: 'aspect-[273.27/345]' },
  home_right: { src: maskHomeRight.src, aspectClass: 'aspect-[273.27/345]' }
}

const { type, class: className, border = false } = Astro.props
const mask = masks[type]
const maskStyle = `--mask-image: url(${mask.src})`
---

<div
  class:list={['relative', mask.aspectClass, !border && 'mask', className]}
  style={!border ? maskStyle : undefined}
>
  {
    border && (
      <div
        class="mask bg-ink absolute inset-0"
        style={maskStyle}
        aria-hidden="true"
      />
    )
  }
  <div
    class:list={['absolute inset-0', border && ['mask', 'inset-px']]}
    style={border ? maskStyle : undefined}
  >
    <div class="absolute inset-0 mask-media">
      <slot />
    </div>
  </div>
</div>

<style>
  .mask {
    mask-image: var(--mask-image);
    -webkit-mask-image: var(--mask-image);
    mask-size: contain;
    -webkit-mask-size: contain;
    mask-repeat: no-repeat;
    -webkit-mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-position: center;
  }

  .mask-media :global(> img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
