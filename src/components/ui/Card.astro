---
import MediaAsset from '@/components/MediaAsset.astro'
import Button from '@/components/ui/Button.astro'
import type { Media } from '@/components/ui/blocks/block-types'
import { useTranslations } from '@/i18n/ui'
import { getPageLocale } from '@/i18n/utils'

type Props = {
  title: string
  media: Media
  description: string
  buttonType?: 'download' | 'link' | 'link-external'
  buttonUrl?: string
  buttonText?: string
}

const {
  title,
  media,
  description,
  buttonType = 'download',
  buttonUrl,
  buttonText
} = Astro.props

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)
---

<article class="flex flex-col gap-4">
  <div class="aspect-4/3 w-full overflow-hidden rounded-sm bg-frost">
    <MediaAsset media={media} title={title} />
  </div>

  <div class="flex flex-col gap-2">
    <h2 class="text-navy text-body-bold">{title}</h2>
    <p class="text-navy text-body pb-3">{description}</p>
    {
      buttonUrl && buttonType === 'download' && (
        <Button
          href={buttonUrl}
          variant="secondary-white"
          icon="download"
          class="self-start"
        >
          <span>{t('card.download')}</span>
        </Button>
      )
    }
    {
      buttonUrl && buttonType === 'link-external' && (
        <Button href={buttonUrl} variant="primary-blue" class="self-start">
          <span>{buttonText}</span>
        </Button>
      )
    }
    {
      buttonUrl && buttonType === 'link' && (
        <Button
          href={buttonUrl}
          internal
          variant="primary-blue"
          class="self-start"
        >
          <span>{buttonText}</span>
        </Button>
      )
    }
  </div>
</article>
