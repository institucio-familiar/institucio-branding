---
import MediaAsset from '@/components/MediaAsset.astro'
import Button from '@/components/ui/Button.astro'
import type { Media } from '@/components/ui/blocks/block-types'
import { useTranslations } from '@/i18n/ui'
import { getPageLocale } from '@/i18n/utils'

type Props = {
  title: string
  media: Media
  description: string
  buttonUrl?: string
}

const { title, media, description, buttonUrl } = Astro.props

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)
---

<article class="flex flex-col gap-4">
  <div class="aspect-square w-full overflow-hidden rounded-sm bg-frost">
    <MediaAsset media={media} title={title} />
  </div>

  <div class="flex flex-col gap-4">
    <h2 class="text-navy text-body-bold">{title}</h2>
    <p class="text-navy text-body">{description}</p>
    {
      buttonUrl && (
        <Button
          href={buttonUrl}
          variant="secondary-white"
          icon="download"
          class="self-start"
        >
          <slot name="button">{t('recursos.download')}</slot>
        </Button>
      )
    }
  </div>
</article>
