---
import MediaAsset from '@/components/MediaAsset.astro'
import type { Block7 } from '@/components/ui/blocks/block-types'

// Bad uses
type Props = Block7

const { title, description, items } = Astro.props
---

<div class="w-full text-navy" data-reveal-in-view>
  <h3 class="text-headline-2 uppercase">{title}</h3>
  <p class="text-body pt-4 pb-10">{description}</p>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-6">
    {
      items.map((item) => (
        <div>
          <div class="aspect-square w-full overflow-hidden rounded-sm">
            <MediaAsset media={item.media} />
          </div>
          <p class="pt-4 pb-4 text-body">{item.description}</p>
        </div>
      ))
    }
  </div>
</div>
