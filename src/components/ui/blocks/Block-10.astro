---
import MediaAsset from '@/components/MediaAsset.astro'
import type { Block10 } from '@/components/ui/blocks/block-types'
import { useTranslations } from '@/i18n/ui'
import { getPageLocale } from '@/i18n/utils'

type Props = Block10

const { title, description, media1, media2 } = Astro.props

const locale = getPageLocale(Astro.currentLocale, Astro.params.locale)
const t = useTranslations(locale)

const buttonBase =
  'inline-flex items-center justify-center rounded-sm border py-2 pr-4 pl-4 text-small transition-colors duration-200 cursor-pointer border-blue bg-transparent text-blue data-active:border-transparent data-active:bg-blue data-active:text-frost'
---

<div
  class="grid w-full gap-indent text-navy md:grid-cols-12"
  data-reveal-in-view
  data-media-toggle
>
  <div class="col-span-5 flex flex-col justify-end gap-3 md:pb-11">
    <p class="text-body-bold">{title}</p>
    <p class="text-body">{description}</p>
  </div>
  <div class="col-span-7">
    <div class="aspect-4/3 w-full overflow-hidden rounded-sm">
      <div data-media-toggle-panel>
        <MediaAsset media={media1} />
      </div>
      <div class="hidden" data-media-toggle-panel>
        <MediaAsset media={media2} />
      </div>
    </div>
    <div class="mt-3 flex gap-3">
      <button
        type="button"
        class={buttonBase}
        data-media-toggle-btn
        data-active
        aria-pressed="true"
      >
        {t('blocks.mediaToggle.example')}
      </button>
      <button
        type="button"
        class={buttonBase}
        data-media-toggle-btn
        aria-pressed="false"
      >
        {t('blocks.mediaToggle.gridSetup')}
      </button>
    </div>
  </div>
</div>

<script>
  const destroyFns: (() => void)[] = []

  document
    .querySelectorAll<HTMLElement>('[data-media-toggle]')
    .forEach((root) => {
      const panels = Array.from(
        root.querySelectorAll<HTMLElement>('[data-media-toggle-panel]')
      )
      const buttons = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-media-toggle-btn]')
      )

      if (panels.length === 0 || buttons.length === 0) return

      const setActiveIndex = (index: number) => {
        panels.forEach((panel, panelIndex) => {
          panel.classList.toggle('hidden', panelIndex !== index)
        })

        buttons.forEach((button, buttonIndex) => {
          const isActive = buttonIndex === index
          button.toggleAttribute('data-active', isActive)
          button.setAttribute('aria-pressed', String(isActive))
        })
      }

      const listeners = buttons.map((button, index) => {
        const onClick = () => setActiveIndex(index)
        button.addEventListener('click', onClick)
        return { button, onClick }
      })

      setActiveIndex(0)

      destroyFns.push(() => {
        listeners.forEach(({ button, onClick }) => {
          button.removeEventListener('click', onClick)
        })
      })
    })

  const destroyMediaToggles = () => destroyFns.forEach((fn) => fn())

  document.addEventListener(
    'swup:visit:start',
    () => {
      destroyMediaToggles()
    },
    { once: true }
  )
</script>
