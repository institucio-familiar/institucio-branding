---
import MediaAsset from '@/components/MediaAsset.astro'
import type { Block3 } from '@/components/ui/blocks/block-types'

type Props = Block3

const { title, description, media } = Astro.props
---

<section class="grid w-full gap-indent md:grid-cols-12">
  <div class="flex flex-col justify-between gap-6 col-span-5">
    <p class="text-headline-3">{title}</p>
    <p class="text-body">{description}</p>
  </div>
  <div class="aspect-4/3 w-full overflow-hidden rounded-sm col-span-7">
    <MediaAsset media={media} />
  </div>
</section>
