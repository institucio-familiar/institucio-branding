---
import MediaAsset from '@/components/MediaAsset.astro'
import type { Block2 } from '@/components/ui/blocks/block-types'

type Props = Block2

const { media1, media2 } = Astro.props
---

<div class="grid w-full gap-indent text-navy md:grid-cols-2">
  <div class="aspect-square w-full overflow-hidden rounded-sm">
    <MediaAsset media={media1} />
  </div>
  <div class="aspect-square w-full overflow-hidden rounded-sm">
    <MediaAsset media={media2} />
  </div>
</div>
