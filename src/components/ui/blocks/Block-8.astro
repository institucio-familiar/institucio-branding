---
import Carousel from '@/components/Carousel.astro'
import type { Block8 } from '@/components/ui/blocks/block-types'

type Props = Block8

const { titleSize = 'text-body-bold', title, description, medias } = Astro.props
---

<div class="w-full text-navy" data-reveal-in-view>
  <h3 class={titleSize}>{title}</h3>
  <p class="text-body pt-2 pb-6 md:pt-4 md:pb-8 max-w-4xl">{description}</p>
  <Carousel medias={medias} aspectRatio="video" />
</div>
