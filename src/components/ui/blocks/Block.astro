---
import Block1 from '@/components/ui/blocks/Block-1.astro'
import Block2 from '@/components/ui/blocks/Block-2.astro'
import type { BlockData } from '@/components/ui/blocks/block-types'

type Props = BlockData

const { type, block } = Astro.props
---

{type === 'block_1' && <Block1 media1={block.media1} />}
{type === 'block_2' && <Block2 media1={block.media1} media2={block.media2} />}
