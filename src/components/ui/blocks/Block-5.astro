---
import Carousel from '@/components/Carousel.astro'
import type { Block5 } from '@/components/ui/blocks/block-types'

type Props = Block5

const { title, description, medias } = Astro.props
---

<section class="grid w-full gap-indent text-navy md:grid-cols-12">
  <div class="flex flex-col justify-end gap-3 col-span-5">
    <p class="text-body-bold">{title}</p>
    <p class="text-body">{description}</p>
  </div>
  <div class="col-span-7">
    <Carousel medias={medias} aspectRatio="square" />
  </div>
</section>
