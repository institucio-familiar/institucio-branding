---
import Carousel from '@/components/Carousel.astro'
import type { Block5 } from '@/components/ui/blocks/block-types'

type Props = Block5

const { bigTitle, title, description, medias } = Astro.props
---

<div class="grid grid-cols-12 w-full gap-indent text-navy" data-reveal-in-view>
  <div class="flex flex-col justify-between col-span-12 md:col-span-5 md:pb-10">
    {bigTitle ? <p class="text-headline-3 max-w-[70%]">{bigTitle}</p> : <div />}
    <div>
      <p class="text-body-bold pb-3">{title}</p>
      <p class="text-body">{description}</p>
    </div>
  </div>
  <div class="col-span-12 md:col-span-7">
    <Carousel medias={medias} aspectRatio="square" />
  </div>
</div>
