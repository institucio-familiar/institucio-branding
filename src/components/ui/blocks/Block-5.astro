---
import MediaAsset from '@/components/MediaAsset.astro'
import Carousel from '@/components/Carousel.astro'
import type { Block5 } from '@/components/ui/blocks/block-types'

type Props = Block5

const { title, description, medias } = Astro.props

// TESTINGAL > Add carousel here
---

<section class="grid w-full gap-indent md:grid-cols-12">
  <div class="flex flex-col justify-end gap-3 col-span-5">
    <p class="text-body-bold">{title}</p>
    <p class="text-body">{description}</p>
  </div>
  <div class="aspect-4/3 w-full overflow-hidden rounded-sm col-span-7">
    <MediaAsset media={medias[0]} />
    <!-- <Carousel medias={medias} /> -->
  </div>
</section>
