---
import MediaAsset from '@/components/MediaAsset.astro'
import type { Media } from '@/components/ui/blocks/block-types'

interface Props {
  image1?: Media | null
  image2?: Media | null
  image3?: Media | null
  image4?: Media | null
  image5?: Media | null
}

const { image1, image2, image3, image4, image5 } = Astro.props

const images = [image1, image2, image3, image4, image5]
const hasContent = images.every(Boolean)

const mobileAspects = [
  'aspect-video',
  'aspect-4/3',
  'aspect-video',
  'aspect-4/3',
  'aspect-video'
] as const
---

{
  hasContent && (
    <section
      class="relative overflow-x-clip bg-frost"
      data-home-animated-grid
      data-header-theme="light"
    >
      {/* Mobile: static 1-column grid */}
      <div class="grid grid-cols-1 gap-2 p-2 md:hidden">
        {images.map((image, index) => (
          <div
            class:list={[
              'w-full overflow-hidden rounded-sm',
              mobileAspects[index]
            ]}
          >
            <MediaAsset media={image!} />
          </div>
        ))}
      </div>

      {/* Desktop: animated sticky grid */}
      <div
        data-animated-grid-sticky
        class="relative hidden min-h-lvh w-full md:block"
      >
        <div
          data-grid-center-media
          class="pointer-events-none absolute inset-0 z-0"
          aria-hidden="true"
        >
          <div data-grid-center-media-inner class="h-full w-full">
            <MediaAsset media={image3!} imageSize={2200} />
          </div>
        </div>

        <div class="relative z-10 flex min-h-lvh w-full items-center px-[9vw] py-2">
          <div class="animated-grid grid w-full aspect-1190/765 max-w-7xl grid-cols-3 gap-2 p-2">
            <div class="animated-grid-column flex flex-col items-end gap-2">
              <div
                data-grid-item
                data-grid-slot="left-top"
                data-origin="left"
                class="animated-grid-item"
              >
                <div class="grid-media aspect-video">
                  <MediaAsset media={image1!} class="rounded-sm" />
                </div>
              </div>

              <div
                data-grid-item
                data-grid-slot="left-bottom"
                data-origin="left"
                class="animated-grid-item"
              >
                <div class="grid-media aspect-4/3">
                  <MediaAsset media={image2!} class="rounded-sm" />
                </div>
              </div>
            </div>

            <div class="flex items-center justify-center">
              <div
                data-grid-center-slot
                class="grid-media-center pointer-events-none invisible w-full h-[65lvh] max-h-[45vw]"
                aria-hidden="true"
              />
            </div>

            <div class="animated-grid-column flex flex-col justify-end gap-2">
              <div
                data-grid-item
                data-grid-slot="right-top"
                data-origin="right"
                class="animated-grid-item w-full"
              >
                <div class="grid-media aspect-4/3">
                  <MediaAsset media={image4!} class="rounded-sm" />
                </div>
              </div>

              <div
                data-grid-item
                data-grid-slot="right-bottom"
                data-origin="right"
                class="animated-grid-item w-full"
              >
                <div class="grid-media aspect-video">
                  <MediaAsset media={image5!} class="rounded-sm" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  @media (min-width: 768px) {
    [data-home-animated-grid] {
      height: 400lvh;
    }
  }

  [data-grid-center-media] {
    clip-path: inset(16px round 5px);
    will-change: clip-path;
  }

  [data-grid-center-media-inner] {
    transform-origin: center center;
    will-change: transform;
  }

  [data-grid-center-media-inner] :global(img),
  [data-grid-center-media-inner] :global(video) {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center;
  }

  .grid-media {
    isolation: isolate;
    height: 15vw;
  }

  .grid-media :global(img),
  .grid-media :global(video) {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>
