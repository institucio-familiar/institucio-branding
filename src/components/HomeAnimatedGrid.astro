---
import MediaAsset from '@/components/MediaAsset.astro'
import type { Media } from '@/components/ui/blocks/block-types'

interface Props {
  image1?: Media | null
  image2?: Media | null
  image3?: Media | null
  image4?: Media | null
  image5?: Media | null
}

const { image1, image2, image3, image4, image5 } = Astro.props

const images = [image1, image2, image3, image4, image5]
const hasContent = images.every(Boolean)

const mobileAspects = [
  'aspect-video',
  'aspect-4/3',
  'aspect-video',
  'aspect-4/3',
  'aspect-video'
] as const
---

{
  hasContent && (
    <section
      class="relative overflow-x-clip bg-frost"
      data-home-animated-grid
      data-header-theme="light"
    >
      {/* Mobile: static 1-column grid */}
      <div class="grid grid-cols-1 gap-2 p-2 md:hidden">
        {images.map((image, index) => (
          <div
            class:list={[
              'w-full overflow-hidden rounded-sm',
              mobileAspects[index]
            ]}
          >
            <MediaAsset media={image!} />
          </div>
        ))}
      </div>

      {/* Desktop: animated sticky grid */}
      <div data-animated-grid-sticky class="relative hidden min-h-svh w-full md:block">
        <div
          data-grid-center-media
          class="pointer-events-none absolute inset-0 z-0"
          aria-hidden="true"
        >
          <div data-grid-center-media-inner class="h-full w-full">
            <MediaAsset media={image3!} imageSize={2200} />
          </div>
        </div>

        <div class="relative z-10 flex min-h-svh w-full items-center px-[9vw] py-2">
          <div class="animated-grid grid w-full aspect-1190/765 max-w-7xl grid-cols-3 gap-2 p-2">
            <div class="animated-grid-column flex flex-col items-end gap-2">
              <div
                data-grid-item
                data-grid-slot="left-top"
                data-origin="left"
                class="animated-grid-item"
              >
                <div class="grid-media aspect-video">
                  <MediaAsset media={image1!} class="rounded-sm" />
                </div>
              </div>

              <div
                data-grid-item
                data-grid-slot="left-bottom"
                data-origin="left"
                class="animated-grid-item"
              >
                <div class="grid-media aspect-4/3">
                  <MediaAsset media={image2!} class="rounded-sm" />
                </div>
              </div>
            </div>

            <div class="flex items-center justify-center">
              <div
                data-grid-center-slot
                class="grid-media-center pointer-events-none invisible w-full h-[65svh] max-h-[45vw]"
                aria-hidden="true"
              />
            </div>

            <div class="animated-grid-column flex flex-col justify-end gap-2">
              <div
                data-grid-item
                data-grid-slot="right-top"
                data-origin="right"
                class="animated-grid-item w-full"
              >
                <div class="grid-media aspect-4/3">
                  <MediaAsset media={image4!} class="rounded-sm" />
                </div>
              </div>

              <div
                data-grid-item
                data-grid-slot="right-bottom"
                data-origin="right"
                class="animated-grid-item w-full"
              >
                <div class="grid-media aspect-video">
                  <MediaAsset media={image5!} class="rounded-sm" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  @media (min-width: 768px) {
    [data-home-animated-grid] {
      height: 400svh;
    }
  }

  [data-grid-center-media] {
    clip-path: inset(16px round 5px);
    will-change: clip-path;
  }

  [data-grid-center-media-inner] {
    transform-origin: center center;
    will-change: transform;
  }

  [data-grid-center-media-inner] :global(img),
  [data-grid-center-media-inner] :global(video) {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center;
  }

  .grid-media {
    isolation: isolate;
    height: 15vw;
  }

  .grid-media :global(img),
  .grid-media :global(video) {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center;
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const NAVY = '#0b2449'
  const FROST = '#eef3fd'
  const BLUE = '#1469ff'
  const MD_QUERY = '(min-width: 768px)'

  const section = document.querySelector('[data-home-animated-grid]')

  if (section && !section.hasAttribute('data-animated-grid-init')) {
    section.setAttribute('data-animated-grid-init', '')

    const sticky = section.querySelector('[data-animated-grid-sticky]')
    const centerMedia = section.querySelector(
      '[data-grid-center-media]'
    ) as HTMLElement | null
    const centerMediaInner = section.querySelector(
      '[data-grid-center-media-inner]'
    )
    const centerSlot = section.querySelector('[data-grid-center-slot]')
    const slotOrder = ['left-top', 'right-top', 'left-bottom', 'right-bottom']
    const tweens: (gsap.core.Tween | gsap.core.Timeline)[] = []
    const colorTriggers: ScrollTrigger[] = []

    gsap.set(section, { backgroundColor: NAVY })

    const animateBackground = (color: string) => {
      gsap.to(section, {
        backgroundColor: color,
        duration: 0.6,
        ease: 'power2.inOut',
        overwrite: 'auto'
      })
    }

    colorTriggers.push(
      ScrollTrigger.create({
        trigger: section,
        start: 'top 50%',
        onEnter: () => animateBackground(FROST),
        onLeaveBack: () => animateBackground(NAVY)
      })
    )

    colorTriggers.push(
      ScrollTrigger.create({
        trigger: section,
        start: 'bottom 50%',
        onEnter: () => animateBackground(BLUE),
        onLeaveBack: () => animateBackground(FROST)
      })
    )

    if (window.matchMedia(MD_QUERY).matches && sticky) {
      const CLIP_ROUND = 5
      const CLIP_START = 16

      type ClipInsets = {
        top: number
        right: number
        bottom: number
        left: number
        round: number
      }

      let targetClip: ClipInsets = {
        top: CLIP_START,
        right: CLIP_START,
        bottom: CLIP_START,
        left: CLIP_START,
        round: CLIP_ROUND
      }

      function measureTargetClip(): ClipInsets {
        if (!centerMedia || !centerSlot) {
          return targetClip
        }

        const mediaRect = centerMedia.getBoundingClientRect()
        const slotRect = centerSlot.getBoundingClientRect()

        return {
          top: Math.max(0, slotRect.top - mediaRect.top),
          right: Math.max(0, mediaRect.right - slotRect.right),
          bottom: Math.max(0, mediaRect.bottom - slotRect.bottom),
          left: Math.max(0, slotRect.left - mediaRect.left),
          round: CLIP_ROUND
        }
      }

      function applyCenterClip(progress: number) {
        if (!centerMedia) return

        const top = gsap.utils.interpolate(CLIP_START, targetClip.top, progress)
        const right = gsap.utils.interpolate(
          CLIP_START,
          targetClip.right,
          progress
        )
        const bottom = gsap.utils.interpolate(
          CLIP_START,
          targetClip.bottom,
          progress
        )
        const left = gsap.utils.interpolate(
          CLIP_START,
          targetClip.left,
          progress
        )

        centerMedia.style.clipPath = `inset(${top}px ${right}px ${bottom}px ${left}px round ${CLIP_ROUND}px)`
      }

      function refreshClipTarget() {
        targetClip = measureTargetClip()
      }

      refreshClipTarget()

      const clipProgress = { value: 0 }

      const timeline = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: 'bottom bottom',
          scrub: true,
          pin: sticky,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onRefreshInit: refreshClipTarget,
          onRefresh: () => applyCenterClip(clipProgress.value)
        }
      })

      timeline.to(
        clipProgress,
        {
          value: 1,
          ease: 'power4.out',
          duration: 6,
          onUpdate: () => applyCenterClip(clipProgress.value)
        },
        0
      )

      if (centerMediaInner) {
        timeline.fromTo(
          centerMediaInner,
          { scale: 1 },
          { scale: 0.65, ease: 'power4.out', duration: 6 },
          0
        )
      }

      slotOrder.forEach((slot, index) => {
        const item = section.querySelector(`[data-grid-slot="${slot}"]`)
        if (!item) return

        const origin = item.getAttribute('data-origin')
        const fromX = origin === 'right' ? '50vw' : '-50vw'
        const fromY = origin === 'right' ? '30vh' : '30vh'

        timeline.fromTo(
          item,
          { x: fromX, y: fromY },
          {
            x: 0,
            y: 0,
            ease: 'power4.out',
            duration: 6
          },
          index * 0.25
        )
      })

      tweens.push(timeline)
    }

    document.addEventListener(
      'swup:visit:start',
      () => {
        colorTriggers.forEach((trigger) => trigger.kill())
        gsap.killTweensOf(section)
        tweens.forEach((tween) => {
          tween.scrollTrigger?.kill()
          tween.kill()
        })
        section.removeAttribute('data-animated-grid-init')
      },
      { once: true }
    )
  }
</script>
