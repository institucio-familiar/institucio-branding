---
import type { SanityImageSource } from '@sanity/image-url'
import { urlForImage } from '@/sanity/lib/image'

interface Props {
  images: SanityImageSource[]
  textLines: {
    line1: string
    line2: string
    line3: string
  }
}

const { images, textLines } = Astro.props
const hasContent = images.length > 0

const { line1, line2, line3 } = textLines
---

{
  hasContent && (
    <section class="relative bg-white" data-home-carousel-illustrations>
      <div
        data-carousel-sticky
        class="relative flex h-lvh w-full items-center overflow-hidden"
      >
        <div
          data-carousel-text
          class="carousel-text pointer-events-none absolute inset-0 z-0 flex items-center justify-center"
        >
          <div class="flex flex-col items-center text-center">
            {line1 && (
              <p
                data-carousel-text-line="1"
                class="carousel-text-line text-navy text-headline-1 uppercase"
              >
                {line1}
              </p>
            )}
            {line2 && (
              <p
                data-carousel-text-line="2"
                class="carousel-text-line text-navy text-headline-1 uppercase"
              >
                {line2}
              </p>
            )}
            {line3 && (
              <p
                data-carousel-text-line="3"
                class="carousel-text-line text-navy text-headline-1 uppercase"
              >
                {line3}
              </p>
            )}
          </div>
        </div>
        <div data-carousel-track class="carousel-track flex w-max items-center">
          {images.map((image, index) => (
            <div
              data-carousel-item
              data-index={index}
              class:list={[
                'carousel-illustration shrink-0',
                index >= 5 && index <= 6 && 'px-[clamp(1rem,3vw,2rem)]'
              ]}
            >
              <img
                src={urlForImage(image).width(500).url()}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
          ))}

          <div
            data-carousel-item
            data-carousel-video-item
            class="carousel-illustration carousel-video-item shrink-0"
          >
            <video
              data-carousel-video-media
              class="carousel-video-media aspect-square"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            >
              <source
                src="https://cdn.sanity.io/files/ryub47of/production/b3fda7171e2c180def76adc3055e01e994521506.mov"
                type='video/quicktime; codecs="hvc1"'
              />
              <source
                src="https://cdn.sanity.io/files/ryub47of/production/f949fa0822b3e1a2e3c2d9971165d6d1bd5ec894.webm"
                type="video/webm"
              />
            </video>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  [data-home-carousel-illustrations] {
    height: 650lvh;
  }

  .carousel-track {
    will-change: transform;
  }

  .carousel-illustration {
    width: clamp(9rem, 22vw, 18rem);
    will-change: transform;
    transform-origin: center center;
  }

  .carousel-illustration img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .carousel-video-item {
    position: relative;
    z-index: 10;
    overflow: hidden;
    will-change: transform;
    transform-origin: center center;
  }

  .carousel-video-media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
    transform-origin: center center;
  }

  .carousel-text-line {
    will-change: transform;
  }
</style>
