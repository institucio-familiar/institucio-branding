---
import Puncha from '@/components/icons/Puncha.astro'
import MediaAsset from '@/components/MediaAsset.astro'
import Mask from '@/components/ui/Mask.astro'
import type { Media } from '@/components/ui/blocks/block-types'
import symbol1 from '@/assets/svgs/symbol_1.svg'
import symbol2 from '@/assets/svgs/symbol_2.svg'
import symbol3 from '@/assets/svgs/symbol_3.svg'
import symbol4 from '@/assets/svgs/symbol_4.svg'
import symbol5 from '@/assets/svgs/symbol_5.svg'
import symbol6 from '@/assets/svgs/symbol_6.svg'
import symbol7 from '@/assets/svgs/symbol_7.svg'
import symbol8 from '@/assets/svgs/symbol_8.svg'
import symbol9 from '@/assets/svgs/symbol_9.svg'
import symbol10 from '@/assets/svgs/symbol_10.svg'

interface Props {
  text: string
  image?: Media | null
}

const { text, image } = Astro.props
const hasContent = Boolean(text)

const symbols = [
  symbol1,
  symbol2,
  symbol3,
  symbol4,
  symbol5,
  symbol6,
  symbol7,
  symbol8,
  symbol9,
  symbol10
]
---

{
  hasContent && (
    <div class="relative w-full bg-white" data-home-values-scroll>
      <div
        data-home-values-sticky
        class="relative min-h-lvh w-full overflow-hidden"
      >
        <section
          class="values-section relative w-full"
          data-home-values-section
          data-header-theme="light"
        >
          <div class="absolute inset-0 flex items-center justify-center h-lvh">
            <div
              data-home-values-bg
              class="values-bg relative pointer-events-none bg-navy w-full"
            >
              <Puncha
                color="navy"
                class="absolute top-px left-1/2 -translate-x-1/2 -translate-y-full"
              />

              <Puncha
                color="navy"
                class="absolute bottom-px left-1/2 -translate-x-1/2 translate-y-full rotate-180"
              />
            </div>
          </div>

          <div
            data-home-values-inner
            class="values-inner relative z-1 flex gap-24 w-full flex-col items-center px-indent pb-20 md:pb-28"
          >
            <div
              data-values-symbols
              class="values-symbols relative aspect-square w-(--values-symbol-size) shrink-0"
            >
              {symbols.map((symbol, index) => (
                <img
                  src={symbol.src}
                  alt=""
                  data-values-symbol
                  data-index={index}
                  class="values-symbol absolute inset-0 h-full w-full object-contain"
                  loading="lazy"
                  decoding="async"
                />
              ))}
            </div>

            <div
              data-values-reveal
              class="flex w-full flex-col items-center gap-24 md:gap-16"
            >
              <p class="text-frost text-headline-2 text-center uppercase w-[clamp(300px,70vw,1024px)]">
                {text}
              </p>

              {image && (
                <div
                  id="mask-zoom"
                  class="w-[min(80vw,22rem)] md:w-[min(70vw,28rem)]"
                >
                  <Mask type="4o" class="h-full w-full">
                    <MediaAsset media={image} />
                  </Mask>
                </div>
              )}
            </div>
          </div>
        </section>
      </div>
    </div>
  )
}

<style>
  [data-home-values-scroll] {
    height: 400lvh;
    min-height: 100lvh;
  }

  .values-inner {
    --values-symbol-size: clamp(6rem, 15vw, 10rem);
    padding-top: calc(50lvh - calc(var(--values-symbol-size) / 2));
    will-change: transform;
  }

  .values-bg {
    will-change: height;
  }

  .values-symbol {
    opacity: 0;
    visibility: hidden;
  }

  .values-symbol[data-index='0'] {
    opacity: 1;
    visibility: visible;
  }
</style>
