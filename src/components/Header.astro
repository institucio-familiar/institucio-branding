---
import { getRelativeLocaleUrl } from 'astro:i18n'
import LanguageSwitcher from '@/components/LanguageSwitcher.astro'
import { useTranslations } from '@/i18n/ui'
import { getPageLocale } from '@/i18n/utils'
import Button from '@/components/ui/Button.astro'
import { HELP_EMAIL } from '@/constants'
import ColegioNombre from '@/components/icons/ColegioNombre.astro'
import ColegioEscudo from '@/components/icons/ColegioEscudo.astro'
import Menu from '@/components/Menu.astro'

const locale = getPageLocale(Astro.currentLocale, Astro.params.locale)
const t = useTranslations(locale)
---

<div data-header data-theme="light" class="fixed inset-x-0 top-0 z-50">
  <header class="absolute left-0 z-10">
    <div class="flex items-end gap-2 px-indent py-3 md:py-7">
      <a href={getRelativeLocaleUrl(locale)} class="flex items-end">
        <div data-header-logo-escudo-wrap class="flex h-[42px] items-end">
          <ColegioEscudo class="header-logo h-[42px] w-auto" />
        </div>
        <div data-header-logo-nombre-wrap class="overflow-hidden pl-2">
          <ColegioNombre class="header-logo h-[36px] w-auto" />
        </div>
      </a>
      <Menu />
    </div>
  </header>

  <div
    class="absolute top-4 right-indent flex items-center gap-4 md:top-8"
    data-header-actions
  >
    <Button
      variant="secondary-white"
      class="header-help"
      href={`mailto:${HELP_EMAIL}`}
    >
      {t('header.needHelp')}
    </Button>
    <LanguageSwitcher />
  </div>
</div>

<style>
  [data-header] {
    --header-logo: var(--color-white);
    --header-fg: var(--color-frost);
  }

  [data-header][data-theme='dark'] {
    --header-logo: var(--color-navy);
    --header-fg: var(--color-navy);
  }

  [data-header] :global(.header-logo path) {
    transition: fill 0.2s ease;
  }

  [data-header] :global([data-language-switcher] a) {
    color: var(--header-fg);
    transition: color 0.2s ease;
  }

  [data-header] :global([data-language-switcher] a:hover) {
    color: var(--color-blue);
  }

  [data-header][data-theme='dark'] :global(.header-help) {
    border-color: var(--color-navy);
    background-color: transparent;
    color: var(--color-navy);
  }

  [data-header][data-theme='dark'] :global(.header-help:hover) {
    border-color: var(--color-navy);
    background-color: var(--color-navy);
    color: var(--color-frost);
  }

  [data-header][data-theme='dark'] :global(.header-help:active) {
    border-color: var(--color-navy-light);
    background-color: var(--color-navy-light);
    color: var(--color-frost);
  }
</style>

<script>
  import { $isMenuOpen } from '@/store'
  import { initHeaderTheme } from '@/scripts/header-theme'
  import { initHeaderLogoAnimation } from '@/scripts/header-logo-animation'

  initHeaderTheme()
  initHeaderLogoAnimation()

  document.querySelectorAll('header a').forEach((link) => {
    link.addEventListener('click', () => {
      $isMenuOpen.set(false)
    })
  })
</script>
