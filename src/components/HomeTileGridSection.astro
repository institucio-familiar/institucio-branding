---
import Puncha from '@/components/icons/Puncha.astro'
import MediaAsset from '@/components/MediaAsset.astro'
import Mask from '@/components/ui/Mask.astro'
import type { Media } from '@/components/ui/blocks/block-types'

interface Props {
  image1?: Media | null
  image2?: Media | null
  text1: string
  text2: string
}

const { image1, image2, text1, text2 } = Astro.props
---

<section class="relative bg-white" data-home-tile-grid>
  <div class="grid grid-cols-1 md:grid-cols-2">
    {
      image1 && (
        <div data-tile-grid-mask data-origin="top-left" class="order-1 w-full">
          <Mask type="tibo" class="w-full md:mb-[-3.6vw]">
            <MediaAsset media={image1} />
          </Mask>
        </div>
      )
    }
    <p
      data-tile-grid-text
      class="order-2 aspect-[273.27/345] text-navy text-headline-1 md:text-headline-2 flex items-center justify-center text-center uppercase"
    >
      {text1}
    </p>
    <p
      data-tile-grid-text
      class="order-4 md:order-3 aspect-[273.27/345] text-navy text-headline-1 md:text-headline-2 flex items-center justify-center text-center uppercase"
    >
      {text2}
    </p>
    {
      image2 && (
        <div
          data-tile-grid-mask
          data-origin="top-right"
          class="order-3 md:order-4 w-full"
        >
          <Mask type="tibo" class="w-full">
            <MediaAsset media={image2} />
          </Mask>
        </div>
      )
    }
  </div>
</section>
