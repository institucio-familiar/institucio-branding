---
import iconSection from '@/assets/svgs/icon_section.svg'
import MediaAsset from '@/components/MediaAsset.astro'
import Mask from '@/components/ui/Mask.astro'
import type { Media } from '@/components/ui/blocks/block-types'
import Puncha from '@/components/icons/Puncha.astro'

interface Props {
  firstMessage: {
    text: string
    image?: Media | null
  }
  secondMessage: string
  thirdMessage: string
}

const { firstMessage, secondMessage, thirdMessage } = Astro.props
const hasFirstMessage = Boolean(firstMessage?.text)
---

{
  hasFirstMessage && (
    <section class="relative w-full">
      <div class="absolute inset-0 flex flex-col" aria-hidden="true">
        <div class="h-1/2 bg-frost" />
        <div class="h-1/2 bg-white" />
      </div>
      {firstMessage.image && (
        <Mask type="tobi_horizontal" class="h-full w-full">
          <MediaAsset media={firstMessage.image} imageSize={2000} />
        </Mask>
      )}
      <div
        class="absolute inset-0 flex flex-col z-1 items-center justify-center px-indent"
        aria-hidden="true"
      >
        <p class="text-headline-1 text-frost text-center uppercase">
          {firstMessage.text}
        </p>
      </div>
    </section>
  )
}

{
  secondMessage && (
    <section
      class="relative w-full overflow-hidden bg-white"
      data-home-final-message-second
    >
      <div class="flex min-h-dvh w-full flex-col items-center justify-center gap-8 py-indent">
        <p class="text-headline-1 text-center uppercase text-navy">
          {secondMessage}
        </p>
        <div
          data-final-message-icon-track
          class="relative w-full overflow-hidden"
        >
          <img
            data-final-message-icon
            src={iconSection.src}
            alt=""
            class="final-message-icon block max-w-none px-indent"
            decoding="async"
          />
        </div>
      </div>
    </section>
  )
}

{
  thirdMessage && (
    <section class="relative flex flex-col w-full items-center justify-center bg-white px-indent">
      <p class="text-headline-1 text-navy text-center uppercase">
        {thirdMessage}
      </p>
      <img
        src="https://cdn.sanity.io/images/ryub47of/production/bd1225fc754aae5d9278ff44668adf3ec4e6afb1-2048x2080.png?w=400"
        alt=""
        class="rotate-25 w-[clamp(150px,20vw,340px)]"
        decoding="async"
        loading="lazy"
      />
      <Puncha
        color="white"
        class="absolute bottom-[0.5px] left-1/2 -translate-x-1/2 translate-y-full rotate-180"
      />
    </section>
  )
}

<style>
  .final-message-icon {
    width: 160vw;
    aspect-ratio: 2161 / 445;
    will-change: transform;
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const section = document.querySelector('[data-home-final-message-second]')

  if (section && !section.hasAttribute('data-final-message-second-init')) {
    section.setAttribute('data-final-message-second-init', '')

    const track = section.querySelector('[data-final-message-icon-track]')
    const icon = section.querySelector('[data-final-message-icon]')
    const tweens: (gsap.core.Tween | gsap.core.Timeline)[] = []

    const createAnimation = () => {
      if (!track || !icon) return

      const getTravelDistance = () => window.innerWidth * 0.6

      gsap.set(icon, { x: 0 })

      const timeline = gsap.timeline({
        scrollTrigger: {
          trigger: track,
          start: 'top bottom',
          end: 'bottom top',
          scrub: true,
          invalidateOnRefresh: true
        }
      })

      timeline.fromTo(
        icon,
        { x: 0 },
        {
          x: () => -getTravelDistance(),
          ease: 'none',
          duration: 1,
          immediateRender: false
        }
      )

      tweens.push(timeline)
      ScrollTrigger.refresh()
    }

    if (icon instanceof HTMLImageElement) {
      if (icon.complete) {
        requestAnimationFrame(createAnimation)
      } else {
        icon.addEventListener('load', createAnimation, { once: true })
      }
    }

    document.addEventListener(
      'swup:visit:start',
      () => {
        tweens.forEach((tween) => {
          tween.scrollTrigger?.kill()
          tween.kill()
        })
        section.removeAttribute('data-final-message-second-init')
      },
      { once: true }
    )
  }
</script>
