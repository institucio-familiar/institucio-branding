---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { locales, localeLabels } from '@/i18n/config'
import { getPathKey } from '@/i18n/routes'
import { useTranslations } from '@/i18n/ui'
import { getPageLocale } from '@/i18n/utils'

const currentLocale = getPageLocale(Astro.currentLocale, Astro.params.locale)
const pathKey = getPathKey(Astro.url.pathname)
const t = useTranslations(currentLocale)

const alternateLocale = locales.find((locale) => locale !== currentLocale)

const alternateLocaleUrl = alternateLocale
  ? {
      locale: alternateLocale,
      label: localeLabels[alternateLocale],
      href: getRelativeLocaleUrl(alternateLocale, pathKey)
    }
  : null
---

<nav
  aria-label={t('lang.switch')}
  class="flex items-center text-body"
  data-language-switcher
>
  {
    alternateLocaleUrl && (
      <a
        href={alternateLocaleUrl.href}
        hreflang={alternateLocaleUrl.locale}
        lang={alternateLocaleUrl.locale}
        data-no-swup
        class="px-1 text-frost font-serif font-semibold text-lead transition-colors duration-200 hover:text-blue"
      >
        {alternateLocaleUrl.label}
      </a>
    )
  }
</nav>
