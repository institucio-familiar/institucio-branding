---
type Color =
  | 'ink'
  | 'navy'
  | 'navy-light'
  | 'blue'
  | 'sky'
  | 'sky-light'
  | 'mist'
  | 'frost'
  | 'gray'
  | 'white'

interface Props {
  text: string
  backgroundColor?: Color
  textColor?: Color
}

const { text, backgroundColor = 'navy', textColor = 'frost' } = Astro.props
---

<section
  class="section-top-mask flex min-h-screen w-full items-center justify-center bg-navy px-indent"
  style={`background-color: var(--color-${backgroundColor})`}
>
  <p
    class="text-headline-1 text-center uppercase"
    style={`color: var(--color-${textColor})`}
  >
    {text}
  </p>
</section>

<style>
  .section-top-mask {
    -webkit-mask-image: linear-gradient(#fff, #fff), url('/pincho_invert.svg');
    mask-image: linear-gradient(#fff, #fff), url('/pincho_invert.svg');
    -webkit-mask-size:
      100% 100%,
      clamp(120px, 25vw, 260px) auto;
    mask-size:
      100% 100%,
      clamp(120px, 25vw, 260px) auto;
    -webkit-mask-position:
      center,
      center top;
    mask-position:
      center,
      center top;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-composite: destination-out;
    mask-composite: exclude;
  }
</style>
