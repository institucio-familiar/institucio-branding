---
type Color =
  | 'ink'
  | 'navy'
  | 'navy-light'
  | 'blue'
  | 'sky'
  | 'sky-light'
  | 'mist'
  | 'frost'
  | 'gray'
  | 'white'

interface Props {
  color?: Color
  class?: string
}

const { color, class: className } = Astro.props

const sizeClass = 'h-[25vw] min-h-[120px] max-h-[260px]'
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 56 268"
  class={`${sizeClass} ${className}`}
  aria-hidden="true"
>
  <g transform="translate(0 268) rotate(-90)">
    <path
      d="M267.21 56.14H0C26.04 55.27 51.66 49.22 75.25 38.43C90.08 31.67 104.18 23.02 118.28 11.8L133.24 0L148.06 11.8C162.31 23.02 176.41 31.67 191.23 38.43C214.83 49.22 240.44 55.27 267.21 56.14Z"
      style={color ? `fill: var(--color-${color})` : undefined}></path>
  </g>
</svg>
