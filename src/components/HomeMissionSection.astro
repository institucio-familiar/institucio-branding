---
import Puncha from '@/components/icons/Puncha.astro'
import BracketFrame from '@/components/ui/BracketFrame.astro'

interface Props {
  text: string
}

const { text } = Astro.props
const hasContent = Boolean(text)
---

{
  hasContent && (
    <section
      class="relative w-full bg-frost px-indent"
      data-home-mission-section
    >
      <div
        data-mission-sticky
        class="relative flex h-lvh w-full items-center justify-center"
      >
        <div class="relative flex aspect-square w-full h-full max-w-[90vw] max-h-[90lvh] items-center justify-center gap-4 px-indent-2 py-indent">
          <div
            data-mission-frame="outer"
            class="absolute top-0 left-0 flex h-full w-full items-center justify-center"
          >
            <BracketFrame class="w-full scale-[0.89]" />
          </div>
          <div
            data-mission-frame="middle"
            class="absolute top-0 right-0 flex h-full w-full items-center justify-center"
          >
            <BracketFrame class="w-full scale-[0.7]" />
          </div>
          <div
            data-mission-frame="inner"
            class="absolute top-0 right-0 flex h-full w-full items-center justify-center"
          >
            <BracketFrame class="w-full scale-[0.55]" />
          </div>

          <p
            data-mission-text
            class="text-navy relative z-1 text-center font-serif text-[clamp(24px,4vw,48px)] font-semibold uppercase"
          >
            {text}
          </p>
        </div>
      </div>

      <Puncha
        color="frost"
        class="absolute bottom-[0.5px] left-1/2 z-1 -translate-x-1/2 translate-y-full rotate-180"
      />
    </section>
  )
}

<style>
  [data-home-mission-section] {
    height: 400lvh;
  }

  [data-mission-frame],
  [data-mission-text] {
    opacity: 0;
    visibility: hidden;
    will-change: transform, opacity;
  }
</style>
