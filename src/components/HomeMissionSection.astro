---
import Puncha from '@/components/icons/Puncha.astro'
import BracketFrame from '@/components/ui/BracketFrame.astro'

interface Props {
  text: string
}

const { text } = Astro.props
const hasContent = Boolean(text)
---

{
  hasContent && (
    <section
      class="relative w-full bg-frost px-indent"
      data-home-mission-section
    >
      <div
        data-mission-sticky
        class="relative flex h-lvh w-full items-center justify-center"
      >
        <div class="relative flex aspect-square w-full h-full max-w-[90vw] max-h-[90lvh] items-center justify-center gap-4 px-indent-2 py-indent">
          <div
            data-mission-frame="outer"
            class="absolute top-0 left-0 flex h-full w-full items-center justify-center"
          >
            <BracketFrame class="w-full scale-[0.89]" />
          </div>
          <div
            data-mission-frame="middle"
            class="absolute top-0 right-0 flex h-full w-full items-center justify-center"
          >
            <BracketFrame class="w-full scale-[0.7]" />
          </div>
          <div
            data-mission-frame="inner"
            class="absolute top-0 right-0 flex h-full w-full items-center justify-center"
          >
            <BracketFrame class="w-full scale-[0.55]" />
          </div>

          <p
            data-mission-text
            class="text-navy relative z-1 text-center font-serif text-[clamp(24px,4vw,48px)] font-semibold uppercase"
          >
            {text}
          </p>
        </div>
      </div>

      <Puncha
        color="frost"
        class="absolute bottom-[0.5px] left-1/2 z-1 -translate-x-1/2 translate-y-full rotate-180"
      />
    </section>
  )
}

<style>
  [data-home-mission-section] {
    height: 400lvh;
  }

  [data-mission-frame],
  [data-mission-text] {
    opacity: 0;
    visibility: hidden;
    will-change: transform, opacity;
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const FROST = '#eef3fd'
  const BLUE = '#1469ff'

  const section = document.querySelector('[data-home-mission-section]')

  if (section && !section.hasAttribute('data-mission-init')) {
    section.setAttribute('data-mission-init', '')

    const sticky = section.querySelector('[data-mission-sticky]')
    const frameOrder = ['outer', 'middle', 'inner']
    const text = section.querySelector('[data-mission-text]')
    const punchaPath = section.querySelector('svg path')
    const tweens: (gsap.core.Tween | gsap.core.Timeline)[] = []

    gsap.set(section, { backgroundColor: FROST })
    if (punchaPath) {
      gsap.set(punchaPath, { fill: FROST })
    }

    const colorTimeline = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top 50%',
        toggleActions: 'play none none reverse'
      }
    })

    colorTimeline.to(
      section,
      {
        backgroundColor: BLUE,
        duration: 0.6,
        ease: 'power2.inOut'
      },
      0
    )

    if (punchaPath) {
      colorTimeline.to(
        punchaPath,
        {
          fill: BLUE,
          duration: 0.6,
          ease: 'power2.inOut'
        },
        0
      )
    }

    tweens.push(colorTimeline)

    if (sticky) {
      const frames = frameOrder
        .map((name) => section.querySelector(`[data-mission-frame="${name}"]`))
        .filter(Boolean)

      gsap.set([...frames, text], { autoAlpha: 0 })

      const timeline = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: 'bottom bottom',
          scrub: true,
          pin: sticky,
          anticipatePin: 1
        }
      })

      frames.forEach((frame, index) => {
        timeline.fromTo(
          frame,
          { autoAlpha: 0, scale: 0.85 },
          {
            autoAlpha: 1,
            scale: 1,
            ease: 'power2.out',
            duration: 1
          },
          index === 0 ? 0 : '>'
        )
      })

      if (text) {
        timeline.fromTo(
          text,
          { autoAlpha: 0, y: 40 },
          {
            autoAlpha: 1,
            y: 0,
            ease: 'power2.out',
            duration: 1
          },
          '>'
        )
      }

      tweens.push(timeline)
    }

    document.addEventListener(
      'swup:visit:start',
      () => {
        tweens.forEach((tween) => {
          tween.scrollTrigger?.kill()
          tween.kill()
        })
        section.removeAttribute('data-mission-init')
      },
      { once: true }
    )
  }
</script>
