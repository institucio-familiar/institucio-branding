---
import MediaAsset from '@/components/MediaAsset.astro'
import Mask from '@/components/ui/Mask.astro'
---

<section
  data-home-text-fill
  class="relative min-h-[180svh] overflow-hidden bg-frost pt-nav-height flex items-center"
>
  <div
    data-text-fill-parallax
    class="flex flex-col w-full items-center justify-center px-indent text-[8vw] font-serif font-semibold uppercase lg:text-[8vw] will-change-transform"
  >
    <div class="flex flex-row gap-2 md:gap-4">
      <p class="shrink-0" data-text-fill-line>Acompañar</p>
      <img
        src="https://cdn.sanity.io/images/ryub47of/production/c6fd218fd4e3146b18e20da935bd829919c96b68-510x510.png?w=300"
        alt=""
        data-compass-rotate
        class="w-full max-w-[8vw] translate-y-[-0.5vw] lg:max-w-[8vw]"
      />
      <p class="shrink-0" data-text-fill-line>a las</p>
    </div>
    <div class="flex flex-row gap-2 md:gap-4">
      <p class="shrink-0" data-text-fill-line>familias</p>
      <div
        data-image-zoom
        class="translate-y-[-6px] w-full max-w-[8vw] shrink-0"
      >
        <Mask type="4o" class="w-full">
          <img
            src="https://cdn.sanity.io/images/ryub47of/production/f4ce79b920f9e4ed92beb72d82738b0f29bffc16-1728x2424.png?w=300"
            alt=""
          />
        </Mask>
      </div>
      <p class="shrink-0" data-text-fill-line>en esta</p>
    </div>
    <div class="relative flex flex-row gap-2">
      <div
        class="w-full max-w-[6vw] translate-y-[-1.5vw] scale-[1.5] lg:max-w-[6vw]"
      >
        <img
          src="https://cdn.sanity.io/images/ryub47of/production/ce91b71ea5f84ed1cc48b17744150adb0b589621-1854x2304.png?w=300"
          alt=""
          data-light-on
          class="w-full scale-x-[-1]"
        />
        <img
          src="https://cdn.sanity.io/images/ryub47of/production/3508dd5abbd012e3411d83889b23af4e3af43497-1856x2304.png?w=300"
          alt=""
          class="absolute top-0 left-0 z-[-1] w-full scale-x-[-1]"
        />
      </div>
      <p class="shrink-0" data-text-fill-line>aventura</p>
      <div data-video-clip class="w-[13vw] shrink-0 lg:w-[11vw]">
        <Mask type="tibo_horizontal" class="w-full">
          <MediaAsset
            media={{
              mediaType: 'video',
              playbackId: 'w1AiO61GLM9yZWVlvBtoDZZoqsE299slTkUfWMcXCw00'
            }}
          />
        </Mask>
      </div>
    </div>
  </div>
</section>

<style>
  [data-text-fill-letter] {
    color: var(--color-blue);
    will-change: color;
  }

  [data-light-on] {
    opacity: 0;
  }

  [data-video-clip] {
    --clip-inset-x: 50%;
    clip-path: inset(0 var(--clip-inset-x) 0 var(--clip-inset-x));
    will-change: clip-path;
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  gsap.registerPlugin(ScrollTrigger)

  const BLUE = '#1469ff'
  const NAVY = '#0b2449'

  const section = document.querySelector('[data-home-text-fill]')

  if (section && !section.hasAttribute('data-text-fill-init')) {
    section.setAttribute('data-text-fill-init', '')

    const lines = [...section.querySelectorAll('[data-text-fill-line]')]
    const parallax = section.querySelector('[data-text-fill-parallax]')
    const compassRotate = section.querySelector('[data-compass-rotate]')
    const imageZoom = section.querySelector('[data-image-zoom]')
    const videoClip = section.querySelector('[data-video-clip]')
    const lightOn = section.querySelector('[data-light-on]')
    const tweens: (gsap.core.Tween | gsap.core.Timeline)[] = []

    // Counteract scroll so content rises slower than the page (no pin).
    // Higher travel = slower pass-by. ~0.35vh per side is a gentle lag.
    if (parallax) {
      tweens.push(
        gsap.fromTo(
          parallax,
          { y: () => -window.innerHeight * 0.6 },
          {
            y: () => window.innerHeight * 0.6,
            ease: 'none',
            scrollTrigger: {
              trigger: section,
              start: 'top bottom',
              end: 'bottom top',
              scrub: true,
              invalidateOnRefresh: true
            }
          }
        )
      )
    }

    if (videoClip) {
      const videoClipTimeline = gsap.timeline({
        scrollTrigger: {
          trigger: videoClip,
          start: 'top 82%',
          end: 'center 55%',
          scrub: true
          // markers: true
        }
      })

      videoClipTimeline.fromTo(
        videoClip,
        { '--clip-inset-x': '50%' },
        { '--clip-inset-x': '0%', ease: 'none' },
        0
      )

      if (lightOn) {
        videoClipTimeline.set(lightOn, { autoAlpha: 1 })
      }

      tweens.push(videoClipTimeline)
    }

    if (imageZoom) {
      tweens.push(
        gsap.fromTo(
          imageZoom,
          { scale: 0.65 },
          {
            scale: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: imageZoom,
              start: 'top 72%',
              end: 'center 45%',
              scrub: true
            }
          }
        )
      )
    }

    if (compassRotate) {
      const rotateTween = gsap.fromTo(
        compassRotate,
        { rotation: 0 },
        {
          rotation: 240,
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top 65%',
            end: 'bottom 30%',
            scrub: true,
            invalidateOnRefresh: true
          }
        }
      )

      tweens.push(rotateTween)
    }

    const splitIntoLetters = (paragraph: Element) => {
      const text = paragraph.textContent ?? ''
      const letters: HTMLSpanElement[] = []

      paragraph.textContent = ''
      paragraph.setAttribute('aria-label', text.trim())

      for (const char of text) {
        const span = document.createElement('span')
        span.textContent = char === ' ' ? '\u00a0' : char
        span.setAttribute('data-text-fill-letter', '')
        span.className = 'inline-block'
        letters.push(span)
        paragraph.appendChild(span)
      }

      return letters
    }

    const letters = lines.flatMap((line) => splitIntoLetters(line))

    if (letters.length > 0) {
      gsap.set(letters, { color: BLUE })

      const letterDuration = 1 / letters.length
      const timeline = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: 'top 28%',
          end: 'bottom 85%',
          scrub: true,
          invalidateOnRefresh: true
          // markers: true
        }
      })

      letters.forEach((letter, index) => {
        timeline.to(
          letter,
          {
            color: NAVY,
            ease: 'none',
            duration: letterDuration
          },
          index * letterDuration
        )
      })

      tweens.push(timeline)
    }

    if (tweens.length > 0) {
      ScrollTrigger.refresh()
    }

    document.addEventListener(
      'swup:visit:start',
      () => {
        tweens.forEach((tween) => {
          tween.scrollTrigger?.kill()
          tween.kill()
        })
        section.removeAttribute('data-text-fill-init')
      },
      { once: true }
    )
  }
</script>
