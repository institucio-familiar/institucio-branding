---
interface Props {
  targetId: string
  href: string
  class?: string
  'aria-current'?: 'location' | undefined
}

const {
  targetId,
  href,
  class: className,
  'aria-current': ariaCurrent
} = Astro.props
---

<a
  data-no-swup
  data-scroll-to-button
  href={href}
  class={className}
  aria-current={ariaCurrent}
  data-target-id={targetId}
>
  <slot />
</a>

<script>
  import { Scroll } from '@/scripts/classes/Scroll'
  import { getNavHeight } from '@/scripts/utils/nav-height'

  function scrollToTarget(targetId: string) {
    Scroll.scrollTo(`#${targetId}`, { offset: -getNavHeight() })
  }

  let historyScrollScheduled = false

  function scrollFromLocationHash() {
    if (historyScrollScheduled) return
    historyScrollScheduled = true

    // Double rAF: let Lenis settle after history navigation before scrolling.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        historyScrollScheduled = false

        const hash = location.hash.slice(1)
        if (!hash) {
          Scroll.scrollTo(0)
          return
        }

        Scroll.scrollToHash()
      })
    })
  }

  function onScrollToButtonClick(event: MouseEvent) {
    const target = event.target
    if (!(target instanceof Element)) return

    const button = target.closest<HTMLAnchorElement>('[data-scroll-to-button]')
    if (!button) return

    event.preventDefault()

    const targetId = button.dataset.targetId
    if (!targetId) return

    // Keep the current path (trailing-slash style included) so pushState never
    // triggers a real navigation when menu links use `/page/` and anchors differ.
    history.pushState(null, '', `${location.pathname}${location.search}#${targetId}`)
    scrollToTarget(targetId)
  }

  // Document delegation survives Swup content replaces; Astro module scripts
  // do not re-run for the same URL after the first evaluation.
  const root = window as Window & { __scrollToButtonBound?: boolean }
  if (!root.__scrollToButtonBound) {
    root.__scrollToButtonBound = true
    document.addEventListener('click', onScrollToButtonClick)
    window.addEventListener('popstate', scrollFromLocationHash)
    window.addEventListener('hashchange', scrollFromLocationHash)
  }
</script>
