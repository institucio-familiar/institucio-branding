---
interface Props {
  targetId: string
  href: string
  class?: string
  'aria-current'?: 'location' | undefined
}

const {
  targetId,
  href,
  class: className,
  'aria-current': ariaCurrent
} = Astro.props
---

<a
  data-no-swup
  data-scroll-to-button
  href={href}
  class={className}
  aria-current={ariaCurrent}
  data-target-id={targetId}
>
  <slot />
</a>

<script>
  import { Scroll } from '@/scripts/classes/Scroll'
  import { getNavHeight } from '@/scripts/utils/nav-height'

  function scrollToTarget(targetId: string) {
    Scroll.scrollTo(`#${targetId}`, { offset: -getNavHeight() })
  }

  let historyScrollScheduled = false

  function scrollFromLocationHash() {
    if (historyScrollScheduled) return
    historyScrollScheduled = true

    // Double rAF: let Lenis settle after history navigation before scrolling.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        historyScrollScheduled = false

        const hash = location.hash.slice(1)
        if (!hash) {
          Scroll.scrollTo(0)
          return
        }

        Scroll.scrollToHash()
      })
    })
  }

  document
    .querySelectorAll<HTMLAnchorElement>('[data-scroll-to-button]')
    .forEach((button) => {
      button.addEventListener('click', (event) => {
        event.preventDefault()

        const targetId = button.dataset.targetId
        if (!targetId) return

        const href = button.getAttribute('href')
        if (href) {
          history.pushState(null, '', href)
        }

        scrollToTarget(targetId)
      })
    })

  window.addEventListener('popstate', scrollFromLocationHash)
  window.addEventListener('hashchange', scrollFromLocationHash)
</script>
