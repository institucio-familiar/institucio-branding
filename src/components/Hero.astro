---
import MediaAsset from '@/components/MediaAsset.astro'
import Icon from '@/components/ui/Icon.astro'
import { useTranslations } from '@/i18n/ui'
import { getPageLocale } from '@/i18n/utils'
import type { Media } from '@/components/ui/blocks/block-types'

type Props = {
  media: Media | null
  title?: string
  heading?: string
  imageSize?: number
}

const locale = getPageLocale(Astro.currentLocale, Astro.params.locale)
const t = useTranslations(locale)

const { media, title, heading, imageSize = 1920 } = Astro.props
const mediaTitle = title ?? heading
---

{
  media && (
    <div
      data-hero-media
      class="pointer-events-none fixed inset-0 -z-1 h-screen w-full origin-center"
      style="transform: scale(1.2)"
    >
      <MediaAsset
        media={media}
        title={mediaTitle}
        class="absolute inset-0"
        imageSize={imageSize}
      />
    </div>
  )
}

<div
  data-hero-content
  class="pointer-events-none fixed inset-0 -z-1 flex items-end justify-left px-indent py-15"
>
  <div class="flex flex-col">
    {heading && <h1 class="text-white text-headline-2 uppercase">{heading}</h1>}
    <div class="flex items-center gap-2">
      <p class="text-white text-small">{t('hero.scroll-down')}</p>
      <Icon
        id="scroll-to-bottom-icon"
        name="arrow"
        direction="bottom"
        variant="outline-white"
      />
    </div>
  </div>
</div>

<section
  class="relative min-h-screen"
  data-hero-section
  data-header-theme="light"
>
</section>

<script>
  import { gsap } from 'gsap'

  const heroSection = document.querySelector('[data-hero-section]')
  const heroMedia = document.querySelector('[data-hero-media]')

  if (heroSection && heroMedia) {
    const tween = gsap.fromTo(
      heroMedia,
      { scale: 1.2 },
      {
        scale: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: heroSection,
          start: 'top top',
          end: 'bottom top',
          scrub: true
        }
      }
    )

    document.addEventListener(
      'swup:visit:start',
      () => {
        tween.scrollTrigger?.kill()
        tween.kill()
      },
      { once: true }
    )
  }
</script>
