---
import Cross from '@/components/ui/icon-glyphs/Cross.astro'
import Hamburger from '@/components/ui/icon-glyphs/Hamburger.astro'
import PunchaVertical from '@/components/icons/PunchaVertical.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { useTranslations, type UiKey } from '@/i18n/ui'
import { getPageLocale } from '@/i18n/utils'

const locale = getPageLocale(Astro.currentLocale, Astro.params.locale)
const t = useTranslations(locale)

const MENU_ITEMS: { key: UiKey; href: string }[] = [
  { key: 'nav.nuestraMarca', href: '/nuestra-marca' },
  { key: 'nav.asiHablamos', href: '/asi-hablamos' },
  { key: 'nav.asiNosVemos', href: '/asi-nos-vemos' },
  { key: 'nav.recursos', href: '/recursos' }
]

const SUBMENU_ITEMS: { key: UiKey; href: string }[] = [
  { key: 'nav.overview', href: '/asi-nos-vemos' },
  { key: 'nav.trademarks', href: '/trademarks' },
  { key: 'nav.brandColors', href: '/brand-colors' },
  { key: 'nav.patrones', href: '/patrones' },
  { key: 'nav.iconografia', href: '/iconografia' },
  { key: 'nav.ilustracion', href: '/ilustracion' },
  { key: 'nav.tipografia', href: '/tipografia' },
  { key: 'nav.layout', href: '/layout' },
  { key: 'nav.fotografia', href: '/fotografia' },
  { key: 'nav.motion', href: '/motion' }
]
---

<div>
  <div class="flex">
    <div
      id="menu-overlay"
      class="bg-navy -z-1 fixed inset-0"
      style="transform: translateY(-100%)"
    >
    </div>
    <button
      id="menu-button"
      type="button"
      class="relative inline-flex items-center justify-center rounded-sm border size-7 cursor-pointer border-transparent bg-blue text-frost transition-colors duration-200 hover:border-white hover:bg-white hover:text-blue active:border-transparent active:bg-sky active:text-frost"
      aria-label="Menu"
    >
      <span
        id="menu-icon-hamburger"
        class="absolute inset-0 flex items-center justify-center p-[5px]"
      >
        <Hamburger />
      </span>
      <span
        id="menu-icon-cross"
        class="absolute inset-0 flex items-center justify-center p-1 opacity-0"
      >
        <Cross />
      </span>
    </button>
  </div>
  <div
    id="menu-content"
    class="fixed inset-0 -z-1 flex justify-between pt-[120px] opacity-0 md:items-center md:pt-0"
  >
    <div id="menu-items" class="p-indent">
      <ul class="flex flex-col gap-4">
        {
          MENU_ITEMS.map((item) => (
            <li>
              {item.key === 'nav.asiNosVemos' ? (
                <>
                  <a
                    href={getRelativeLocaleUrl(locale, item.href)}
                    data-menu-link
                    class="hidden md:inline"
                  >
                    <span class="text-white text-headline-menu uppercase hover:text-blue transition-colors duration-200">
                      {t(item.key)}
                    </span>
                  </a>
                  <div class="md:hidden">
                    <button
                      type="button"
                      data-menu-submenu-trigger
                      aria-expanded="false"
                      class="block cursor-pointer border-0 bg-transparent p-0 text-left"
                    >
                      <span class="text-white text-headline-menu uppercase hover:text-blue transition-colors duration-200">
                        {t(item.key)}
                      </span>
                    </button>
                    <div
                      id="mobile-submenu-wrapper"
                      class="overflow-hidden h-0"
                    >
                      <ul
                        id="mobile-submenu"
                        class="grid grid-cols-2 gap-4 pt-4"
                      >
                        {SUBMENU_ITEMS.map((subItem) => (
                          <li>
                            <a
                              href={getRelativeLocaleUrl(locale, subItem.href)}
                              data-menu-link
                            >
                              <span class="text-white text-body hover:text-blue transition-colors duration-200">
                                {t(subItem.key)}
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </>
              ) : (
                <a
                  href={getRelativeLocaleUrl(locale, item.href)}
                  data-menu-link
                >
                  <span class="text-white text-headline-menu uppercase hover:text-blue transition-colors duration-200">
                    {t(item.key)}
                  </span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
    <div
      id="submenu-items"
      class="relative hidden md:flex md:flex-row md:items-center md:h-full"
    >
      <PunchaVertical color="blue" class="translate-x-[0.5px]" />
      <ul
        class="flex flex-col gap-6 justify-center h-full bg-blue py-indent pl-indent-2 pr-indent-3"
      >
        {
          SUBMENU_ITEMS.map((item) => (
            <li>
              <a href={getRelativeLocaleUrl(locale, item.href)} data-menu-link>
                <span class="text-navy text-headline-3 hover:text-frost transition-colors duration-200">
                  {t(item.key)}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<script>
  import { animate, stagger } from 'motion'
  import { Scroll } from '@/scripts/classes/Scroll'
  import { $isMenuOpen } from '@/store'

  const menuButton = document.getElementById('menu-button')
  const mobileSubmenuWrapper = document.getElementById('mobile-submenu-wrapper')
  const submenuTrigger = document.querySelector('[data-menu-submenu-trigger]')
  let isSubmenuOpen = false

  const getSubmenuHeight = () => {
    if (!mobileSubmenuWrapper) return 0
    mobileSubmenuWrapper.style.height = 'auto'
    const height = mobileSubmenuWrapper.scrollHeight
    mobileSubmenuWrapper.style.height = '0px'
    return height
  }

  const closeMobileSubmenu = (animated = true) => {
    isSubmenuOpen = false
    submenuTrigger?.setAttribute('aria-expanded', 'false')

    if (!mobileSubmenuWrapper) return

    if (animated) {
      animate('#mobile-submenu li', { opacity: 0, y: 10 }, { duration: 0.2 })
      animate(
        mobileSubmenuWrapper,
        { height: 0 },
        { duration: 0.35, ease: 'easeInOut' }
      )
    } else {
      mobileSubmenuWrapper.style.height = '0px'
      animate('#mobile-submenu li', { opacity: 0, y: 10 })
    }
  }

  submenuTrigger?.addEventListener('click', () => {
    if (!mobileSubmenuWrapper) return

    if (!isSubmenuOpen) {
      isSubmenuOpen = true
      submenuTrigger.setAttribute('aria-expanded', 'true')
      const targetHeight = getSubmenuHeight()

      animate(
        mobileSubmenuWrapper,
        { height: `${targetHeight}px` },
        { duration: 0.4, ease: 'easeInOut' }
      )
      animate(
        '#mobile-submenu li',
        { opacity: [0, 1], y: [10, 0] },
        { type: 'spring', delay: stagger(0.04, { startDelay: 0.1 }) }
      )
    } else {
      closeMobileSubmenu()
    }
  })

  menuButton?.addEventListener('click', () => {
    $isMenuOpen.set(!$isMenuOpen.get())
  })

  document
    .getElementById('menu-content')
    ?.addEventListener('click', (event) => {
      if ((event.target as Element).closest('[data-menu-link]')) {
        $isMenuOpen.set(false)
      }
    })

  const iconTransition = { duration: 0.35, ease: 'easeInOut' as const }

  $isMenuOpen.subscribe((value: boolean) => {
    menuButton?.setAttribute('aria-label', value ? 'Close' : 'Menu')

    if (value) {
      animate(
        '#menu-icon-hamburger',
        { opacity: 0, scale: 0.8, rotate: -45 },
        iconTransition
      )
      animate(
        '#menu-icon-cross',
        { opacity: 1, scale: 1, rotate: 0 },
        iconTransition
      )
    } else {
      animate(
        '#menu-icon-hamburger',
        { opacity: 1, scale: 1, rotate: 0 },
        iconTransition
      )
      animate(
        '#menu-icon-cross',
        { opacity: 0, scale: 0.8, rotate: 45 },
        iconTransition
      )
    }

    if (!value) {
      closeMobileSubmenu(false)
      Scroll.unlock()
      animate(
        '#menu-overlay',
        // { opacity: 0, width: '10px' },
        { y: '-100%' },
        { duration: 0.6, ease: 'easeInOut' }
      )
      animate(
        '#menu-content',
        { opacity: 0, pointerEvents: 'none' },
        { duration: 0.45, ease: 'easeInOut' }
      )
      animate('#menu-items > ul > li', { opacity: 0 })
      animate(
        '#submenu-items',
        { x: '100%' },
        { duration: 0.45, ease: 'easeInOut' }
      )
      animate('#submenu-items li', { opacity: 0 })
    } else {
      Scroll.lock()
      animate(
        '#menu-overlay',
        // { opacity: 1, width: '400vh' },
        { y: '0%' },
        { duration: 0.6, ease: 'easeInOut' }
      )
      animate(
        '#menu-content',
        {
          opacity: 1,
          pointerEvents: 'auto'
        },
        { duration: 0.45, ease: 'easeInOut' }
      )
      animate(
        '#menu-items > ul > li',
        { opacity: 1, y: [100, 0] },
        { type: 'spring', delay: stagger(0.08), ease: 'easeInOut' }
      )
      animate(
        '#submenu-items',
        { x: '0%' },
        { duration: 0.45, ease: 'easeInOut' }
      )
      animate('#submenu-items li', { opacity: 1 }, { delay: 0.5 })
    }
  })
</script>
