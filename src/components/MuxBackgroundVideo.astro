---
interface Props {
  playbackId: string
  title?: string
  class?: string
}

const { playbackId, title = 'Background video', class: className } = Astro.props
const posterUrl = `https://image.mux.com/${playbackId}/thumbnail.webp?time=0`
---

<div class:list={['mux-bg-video', className]}>
  <mux-player
    playback-id={playbackId}
    poster={posterUrl}
    autoplay="muted"
    muted
    loop
    playsinline
    metadata-video-title={title}
  />
</div>

<script>
  import '@mux/mux-player'
</script>

<style>
  .mux-bg-video :global(mux-player) {
    display: block;
    width: 100%;
    height: 100%;
    --controls: none;
    --media-object-fit: cover;
    --media-object-position: center;
  }
</style>
