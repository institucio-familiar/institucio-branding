---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { useTranslations } from '@/i18n/ui'
import { getPageLocale } from '@/i18n/utils'

const locale = getPageLocale(Astro.currentLocale, Astro.params.locale)
const t = useTranslations(locale)

const navLinks = [
  { path: '', key: 'nav.home' as const },
  { path: 'test', key: 'nav.test' as const }
]

const year = new Date().getFullYear()
---

<footer class="bg-ink text-white">
  <div
    class="flex flex-col gap-10 px-6 py-8 sm:px-8 sm:flex-row sm:items-end sm:justify-between"
  >
    <div class="flex flex-col gap-3">
      <p class="text-headline-3">{t('site.title')}</p>
      <p class="text-cta text-mist">
        &copy; {year}
        {t('footer.rights')}
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-8 gap-y-3 text-body">
      {
        navLinks.map(({ path, key }) => (
          <a
            href={getRelativeLocaleUrl(locale, path)}
            class="text-mist transition-colors duration-200 hover:text-white"
          >
            {t(key)}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
