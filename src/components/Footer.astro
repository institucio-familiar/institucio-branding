---
import ColegioNombre from '@/components/icons/ColegioNombre.astro'
import Icon from '@/components/ui/Icon.astro'
import { useTranslations } from '@/i18n/ui'
import { getPageLocale } from '@/i18n/utils'

const locale = getPageLocale(Astro.currentLocale, Astro.params.locale)
const t = useTranslations(locale)
---

<footer class="bg-blue p-indent">
  <div class="flex flex-col items-center gap-8">
    <div class="flex items-center self-end gap-2">
      <button
        id="scroll-to-top"
        class="cursor-pointer"
        aria-label={t('footer.scrollToTop')}
      >
        {t('footer.scrollToTop')}
      </button>
      <Icon id="scroll-to-top-icon" name="arrow" variant="outline-dark" />
    </div>

    <ColegioNombre color="navy" />
  </div>
</footer>

<script>
  import { Scroll } from '@/scripts/classes/Scroll'

  document
    .getElementById('scroll-to-top')
    ?.addEventListener('click', () => Scroll.scrollTo(0)) ||
    document
      .getElementById('scroll-to-top-icon')
      ?.addEventListener('click', () => Scroll.scrollTo(0))
</script>
