---
import Layout from '../layouts/Layout.astro'
import Puncha from '@/components/icons/Puncha.astro'

// /blog/index.astro
// import { sanityClient } from "sanity:client";
// const posts = await sanityClient.fetch(`*[_type == "post" && defined(slug)] | order(publishedAt desc)`);
---

<Layout>
  <section class="flex min-h-screen items-center justify-center bg-mist">
    <h1 class="text-white text-macro">Institució Branding</h1>
  </section>

  <section
    class="flex min-h-screen items-center justify-center bg-navy relative p-20"
  >
    <Puncha
      color="navy"
      class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y"
    />
    <p class="text-blue text-headline-1 uppercase text-center">
      Educamos a personas únicas, preparándolas para el futuro.
    </p>
  </section>

  <section class="flex min-h-screen items-center justify-center bg-blue">
    <p class="text-white text-headline-3">Section 3 — Blue</p>
  </section>

  <section class="flex min-h-screen items-center justify-center bg-sky">
    <p class="text-white text-headline-3">Section 4 — Sky</p>
  </section>

  <section class="flex min-h-screen items-center justify-center bg-mist">
    <p class="text-ink text-headline-3">Section 5 — Mist</p>
  </section>

  <section class="flex min-h-screen items-center justify-center bg-cream">
    <p class="text-ink text-headline-3">Section 6 — Cream</p>
  </section>
</Layout>
