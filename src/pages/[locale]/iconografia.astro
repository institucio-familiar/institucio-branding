---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { ICONOGRAFIA_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toMedia } from '@/sanity/lib/utils'
import {
  parsePageHeader,
  toAtom1,
  toBadUses,
  toSectionWithAtom1Blocks
} from '@/sanity/lib/page-parsers'
import { Block1, Block4, Block7, Block9 } from '@/components/ui/blocks'
import PageAsideLayout from '@/layouts/page-aside/PageAsideLayout.astro'
import Section from '@/layouts/page-aside/PageAsideSection.astro'
import iconografia1 from '@/assets/svgs/iconografia_1.svg'
import iconografia2 from '@/assets/svgs/iconografia_2.svg'
import iconografia3 from '@/assets/svgs/iconografia_3.svg'
import iconografia4 from '@/assets/svgs/iconografia_4.svg'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(ICONOGRAFIA_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    introMedia: toMedia(sanityPageData?.intro?.media),
    section1: toAtom1(sanityPageData?.section1, locale),
    section2: toSectionWithAtom1Blocks(sanityPageData?.section2, locale),
    section3: toBadUses(sanityPageData?.section3, locale)
  }
}

const pageData = await getPageData()

const asideSections = [
  { id: 'title', label: pageData.pageTitle },
  { id: 'section1', label: pageData.section1?.title || '' }, // TESTINGAL > Typescript > Avoid this from being null
  { id: 'section2', label: pageData.section2.title },
  { id: 'section3', label: pageData.section3.title }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 id="title" class="text-page-title">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/iconografia">
    <Section class="pb-8">
      <p class="text-page-description">
        {pageData.pageDescription}
      </p>
    </Section>
    {
      pageData.introMedia && (
        <Section class="pb-16 md:pb-28">
          <Block1 media1={pageData.introMedia} />
        </Section>
      )
    }
    <Section class="pb-16 md:pb-28">
      <div
        class="flex flex-col text-[7vw] lg:text-[6vw] font-serif font-semibold uppercase text-blue"
      >
        <div class="flex flex-row gap-4 md:gap-6">
          <p>Los iconos</p>
          <img
            src={iconografia1.src}
            alt="ens porta"
            class="w-full max-w-[5vw] lg:max-w-[4vw] translate-y-[-0.5vw]"
          />
          <p>nos</p>
        </div>
        <div class="flex flex-row gap-4 md:gap-6">
          <p>ayudan</p>
          <img
            src={iconografia2.src}
            alt="ens porta"
            class="w-full max-w-[5vw] lg:max-w-[4vw] translate-y-[-0.5vw]"
          />
          <p>a reconocer</p>
        </div>
        <div class="flex flex-row gap-4 md:gap-6">
          <p>ideas</p>
          <img
            src={iconografia3.src}
            alt="ens porta"
            class="w-full max-w-[5.5vw] lg:max-w-[4.5vw] translate-y-[-0.5vw]"
          />
          <p>complejas de</p>
        </div>
        <div class="flex flex-row gap-4 md:gap-6">
          <p>manera</p>
          <img
            src={iconografia4.src}
            alt="ens porta"
            class="w-full max-w-[4.5vw] lg:max-w-[3.5vw] translate-y-[-0.5vw]"
          />
          <p>instantánea.</p>
        </div>
      </div>
    </Section>
    {
      pageData.section1 && pageData.section1.media && (
        <Section id="section1" class="pb-12 md:pb-20">
          <Block7
            title={pageData.section1.title}
            description={pageData.section1.description}
            media={pageData.section1.media}
          />
        </Section>
      )
    }
    {
      pageData.section2 && (
        <Section id="section2" class="pb-16 md:pb-28">
          <h3 class="text-headline-2 uppercase">{pageData.section2.title}</h3>
          <p class="text-body pt-2 pb-6 md:pt-4 md:pb-8 max-w-4xl">
            {pageData.section2.description}
          </p>
          <div class="mt-2 md:mt-4" />
          <div class="flex flex-col gap-4 md:gap-8">
            {pageData.section2.blocks?.map(
              (block) =>
                block.media && (
                  <Block4
                    title={block.title}
                    description={block.description}
                    media={block.media}
                  />
                )
            )}
          </div>
        </Section>
      )
    }
    <Section id="section3" class="pb-12 md:pb-20">
      <Block9
        title={pageData.section3.title}
        description={pageData.section3.description}
        items={pageData.section3.items}
      />
    </Section>
  </PageAsideLayout>
</MainLayout>
