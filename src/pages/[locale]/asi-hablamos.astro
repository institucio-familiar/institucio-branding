---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { ASI_HABLAMOS_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import {
  parsePageHeader,
  toAtom1Array,
  toMedias,
  toSectionWithAtom1Blocks
} from '@/sanity/lib/page-parsers'
import PageAsideLayout from '@/layouts/page-aside/PageAsideLayout.astro'
import Section from '@/layouts/page-aside/PageAsideSection.astro'
import Carousel from '@/components/Carousel.astro'
import Block3 from '@/components/ui/blocks/Block-3.astro'
import { useTranslations } from '@/i18n/ui'
import Card from '@/components/ui/Card.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(ASI_HABLAMOS_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    introMedias: toMedias(sanityPageData?.intro?.medias),
    section1: toSectionWithAtom1Blocks(sanityPageData?.section1, locale),
    section2: {
      blocks: toAtom1Array(sanityPageData?.section2?.blocks, locale)
    },
    section3: (sanityPageData?.section3 ?? []).map((item) => ({
      correct: item.correct?.[locale],
      incorrect: item.incorrect?.[locale]
    })),
    section4: (sanityPageData?.section4 ?? []).map((item) => ({
      correct: item.correct?.[locale],
      incorrect: item.incorrect?.[locale]
    }))
  }
}

const pageData = await getPageData()

const asideSections = [
  { id: 'title', label: pageData.pageTitle ?? '' },
  { id: 'section1', label: t('asi-hablamos.aside.section1') },
  { id: 'section2', label: t('asi-hablamos.aside.section2') },
  { id: 'section3', label: t('asi-hablamos.aside.section3') }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section id="title" class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-page-title">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/asi-hablamos">
    <Section class="pb-8">
      <p class="text-page-description">
        {pageData.pageDescription}
      </p>
    </Section>
    <Section class="pb-8">
      <Carousel medias={pageData.introMedias} aspectRatio="video" />
    </Section>
    {
      pageData.section1 && (
        <Section id="section1" class="py-4 pt-8 md:py-8 md:pt-16">
          <h2 class="text-navy text-headline-2 uppercase">
            {pageData.section1.title}
          </h2>
          <p class="text-body text-navy py-4 pb-12 md:pb-24">
            {pageData.section1.description}
          </p>
          <div class="flex flex-col gap-y-12 md:gap-y-24">
            {pageData.section1.blocks?.map((block) => (
              <Block3
                title={block.title}
                description={block.description}
                media={block.media}
              />
            ))}
          </div>
        </Section>
      )
    }
    {
      pageData.section2 && (
        <Section id="section2" class="py-12 md:py-16">
          <h2 class="text-navy text-headline-4 pb-8">
            {t('asi-hablamos.section2.title')}
          </h2>
          <div class="grid grid-cols-1 gap-8 md:gap-4 md:grid-cols-3">
            {pageData.section2.blocks?.map((block) => (
              <Card
                title={block.title}
                description={block.description}
                media={block.media}
              />
            ))}
          </div>
        </Section>
      )
    }
    {
      pageData.section3 && (
        <Section id="section3" class="py-12 md:py-20 bg-mist">
          <h3 class="text-blue text-headline-4 md:text-headline-3 pb-10">
            {t('asi-hablamos.section3.title')}
          </h3>
          <div class="flex flex-col gap-y-2 md:gap-y-4">
            {pageData.section3.map((block, index) => (
              <p class="text-headline-3 md:text-headline-2 uppercase flex flex-wrap">
                {index % 2 === 0 ? (
                  <>
                    <span class="text-white line-through pr-4 md:pr-6">
                      {block.incorrect}
                    </span>
                    <span class="text-blue">{block.correct}</span>
                  </>
                ) : (
                  <>
                    <span class="pr-4 md:pr-6 text-blue">{block.correct}</span>
                    <span class="text-white line-through">
                      {block.incorrect}
                    </span>
                  </>
                )}
              </p>
            ))}
          </div>
        </Section>
      )
    }
    {
      pageData.section4 && (
        <Section class="py-12 md:py-20 bg-navy-light">
          <h3 class="text-white text-headline-4 md:text-headline-3 pb-4 md:pb-7">
            {t('asi-hablamos.section4.title')}
          </h3>
          <div class="flex flex-col">
            {pageData.section4.map((block) => (
              <div class="flex flex-col pb-8 md:pb-12 gap-2 md:gap-4">
                <p class="text-white text-headline-3 md:text-headline-2 uppercase line-through">
                  {block.incorrect}
                </p>
                <p class="text-blue text-headline-3 md:text-headline-2 uppercase">
                  {block.correct}
                </p>
              </div>
            ))}
          </div>
        </Section>
      )
    }
    <Puncha
      color="navy-light"
      class="absolute bottom-[0.5px] left-1/2 -translate-x-1/2 translate-y-full rotate-180"
    />
  </PageAsideLayout>
</MainLayout>
