---
import Layout from '@/layouts/Layout.astro'
import Puncha from '@/components/icons/Puncha.astro'
import MediaAsset from '@/components/MediaAsset.astro'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import { urlForImage } from '@/sanity/lib/image'
import { sanityClient } from 'sanity:client'
import Icon from '@/components/ui/Icon.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

// TESTINGAL > Add sanity typgen for sanity queries
// TESTINGAL > Cache this, at least in dev
const homePageData = await sanityClient.fetch<{
  hero?: {
    media: {
      mediaType?: 'image' | 'video'
      image?: Parameters<typeof urlForImage>[0]
      video?: {
        asset?: {
          playbackId?: string
        }
      }
    }
  }
}>(`*[_type == "home_page" && _id == "home_page"][0]{
  hero {
  media {
    mediaType,
      image,
      video {
        asset->{
          playbackId
        }
      }
    }
  }
}`)

const heroMedia = homePageData?.hero?.media
---

<Layout>
  <section
    class="flex min-h-screen items-end justify-left bg-mist px-indent py-15 relative"
  >
    <div class="flex flex-col z-2">
      <h1 class="text-white text-headline-2 uppercase">
        {t('home.hero')}
      </h1>
      <div class="flex items-center gap-2">
        <p class="text-white text-body">{t('hero.scroll-down')}</p>
        <Icon
          id="scroll-to-bottom-icon"
          name="arrow"
          direction="bottom"
          variant="outline-white"
        />
      </div>
    </div>

    {
      heroMedia && (
        <MediaAsset
          mediaType={heroMedia.mediaType}
          title={t('home.hero')}
          image={heroMedia.image}
          playbackId={heroMedia.video?.asset?.playbackId}
          class="absolute inset-0"
        />
      )
    }
  </section>

  <section
    class="relative flex min-h-screen items-center justify-center bg-navy p-20"
  >
    <Puncha
      color="navy"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full w-[25vw] min-w-[260px]"
    />
    <p class="text-blue text-headline-1 uppercase text-center">
      {t('home.tagline')}
    </p>
  </section>

  <div>
    <!-- <Puncha color="blue" class="mt-[-20.895%] -mb-px block w-full" /> -->
    <section class="flex min-h-screen items-center justify-center bg-blue p-20">
      <p class="text-white text-headline-3">{t('home.section3')}</p>
    </section>
  </div>

  <section class="flex min-h-screen items-center justify-center bg-sky">
    <p class="text-white text-headline-3">{t('home.section4')}</p>
  </section>

  <section class="flex min-h-screen items-center justify-center bg-mist">
    <p class="text-ink text-headline-3">{t('home.section5')}</p>
  </section>

  <section class="flex min-h-screen items-center justify-center bg-white">
    <p class="text-ink text-headline-3">{t('home.section6')}</p>
  </section>
</Layout>

<script>
  // import { Scroll } from '@/scripts/classes/Scroll'

