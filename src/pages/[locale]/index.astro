---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import Puncha from '@/components/icons/Puncha.astro'
import PunchaVertical from '@/components/icons/PunchaVertical.astro'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import { HOME_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toLocaleString } from '@/sanity/lib/page-parsers'
import { toMedia } from '@/sanity/lib/utils'
import HomeMaskSection from '@/components/HomeMaskSection.astro'
import HomeTileGridSection from '@/components/HomeTileGridSection.astro'
import HomeCarouselIllustrationsSection from '@/components/HomeCarouselIllustrationsSection.astro'
import HomeValuesSection from '@/components/HomeValuesSection.astro'
import HomeAnimatedGrid from '@/components/HomeAnimatedGrid.astro'
import HomeMissionSection from '@/components/HomeMissionSection.astro'
import HomeTextFillSection from '@/components/HomeTextFillSection.astro'
import HomeSlidesStackStickySection from '@/components/HomeSlidesStackStickySection.astro'
import HomeFinalMessageSection from '@/components/HomeFinalMessageSection.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(HOME_PAGE_QUERY)

  // Parse data
  return {
    heroMedia: toMedia(sanityPageData?.hero?.media),
    heroMediaMobile: toMedia(sanityPageData?.hero?.mediaMobile),
    textSlides: {
      textSlide1: toLocaleString(
        sanityPageData?.textSlides?.textSlide1,
        locale
      ),
      textSlide2: toLocaleString(sanityPageData?.textSlides?.textSlide2, locale)
    },
    videoLogosUrl: sanityPageData?.videoLogos?.asset?.url,
    tileGrid: {
      image1: toMedia(sanityPageData?.tileGrid?.image1),
      image2: toMedia(sanityPageData?.tileGrid?.image2),
      text1: toLocaleString(sanityPageData?.tileGrid?.text1, locale),
      text2: toLocaleString(sanityPageData?.tileGrid?.text2, locale)
    },
    carouselIllustrations: {
      images: sanityPageData?.carouselIllustrations?.images ?? [],
      textLines: {
        line1: toLocaleString(
          sanityPageData?.carouselIllustrations?.text_lines?.line1,
          locale
        ),
        line2: toLocaleString(
          sanityPageData?.carouselIllustrations?.text_lines?.line2,
          locale
        ),
        line3: toLocaleString(
          sanityPageData?.carouselIllustrations?.text_lines?.line3,
          locale
        )
      }
    },
    valuesSection: {
      text: toLocaleString(sanityPageData?.valuesSection?.text, locale),
      image: toMedia(sanityPageData?.valuesSection?.image)
    },
    imagesGrid: {
      image1: toMedia(sanityPageData?.imagesGrid?.image1),
      image2: toMedia(sanityPageData?.imagesGrid?.image2),
      image3: toMedia(sanityPageData?.imagesGrid?.image3),
      image4: toMedia(sanityPageData?.imagesGrid?.image4),
      image5: toMedia(sanityPageData?.imagesGrid?.image5)
    },
    missionSection: {
      text: toLocaleString(sanityPageData?.missionSection?.text, locale)
    },
    slidesSection: {
      images: sanityPageData?.slidesSection?.images ?? [],
      text: toLocaleString(sanityPageData?.slidesSection?.text, locale)
    },
    finalMessageSection: {
      firstMessage: {
        image: toMedia(
          sanityPageData?.finalMessageSection?.firstMessage?.image
        ),
        text: toLocaleString(
          sanityPageData?.finalMessageSection?.firstMessage?.text,
          locale
        )
      },
      secondMessage: {
        text: toLocaleString(
          sanityPageData?.finalMessageSection?.secondMessage?.text,
          locale
        )
      },
      thirdMessage: {
        text: toLocaleString(
          sanityPageData?.finalMessageSection?.thirdMessage?.text,
          locale
        )
      }
    }
  }
}

const pageData = await getPageData()
---

<MainLayout>
  <Hero
    media={pageData.heroMedia}
    mediaMobile={pageData.heroMediaMobile}
    heading={t('home.hero')}
  />

  <div class="relative h-[400lvh] w-full" data-home-sections>
    <div class="sticky top-0 h-lvh w-full">
      <div
        class="relative h-full w-full overflow-x-hidden"
        data-header-theme="light"
      >
        <HomeMaskSection
          text={pageData.textSlides.textSlide1}
          backgroundColor="navy"
          textColor="blue"
        />

        <section
          class="absolute inset-0 z-1 h-full"
          data-home-section-2
          style="transform: translateX(100%)"
        >
          <PunchaVertical
            color="blue"
            class="absolute left-[0.5px] top-[50%] -translate-y-1/2 -translate-x-full"
          />
          <div class="flex items-center justify-center p-20 h-full bg-blue">
            <p class="text-navy text-headline-1 uppercase text-center">
              {pageData.textSlides.textSlide2}
            </p>
          </div>
        </section>
      </div>

      <Puncha
        color="blue"
        class="absolute bottom-[0.5px] left-1/2 -z-1 -translate-x-1/2 translate-y-full rotate-180"
      />
    </div>
  </div>

  <section class="w-full aspect-video">
    <video
      src={pageData.videoLogosUrl}
      autoplay
      muted
      loop
      playsinline
      class="w-full h-full object-cover bg-white"></video>
  </section>

  <HomeTileGridSection
    image1={pageData.tileGrid.image1}
    image2={pageData.tileGrid.image2}
    text1={pageData.tileGrid.text1}
    text2={pageData.tileGrid.text2}
  />

  <HomeCarouselIllustrationsSection
    images={pageData.carouselIllustrations.images}
    textLines={pageData.carouselIllustrations.textLines}
  />

  <HomeValuesSection
    text={pageData.valuesSection.text}
    image={pageData.valuesSection.image}
  />

  <HomeAnimatedGrid
    image1={pageData.imagesGrid.image1}
    image2={pageData.imagesGrid.image2}
    image3={pageData.imagesGrid.image3}
    image4={pageData.imagesGrid.image4}
    image5={pageData.imagesGrid.image5}
  />

  <HomeMissionSection text={pageData.missionSection.text} />

  <HomeTextFillSection />

  <HomeSlidesStackStickySection
    images={pageData.slidesSection.images}
    text={pageData.slidesSection.text}
  />
  <div class="h-[20vw] w-full bg-frost"></div>

  <HomeFinalMessageSection
    firstMessage={pageData.finalMessageSection.firstMessage}
    secondMessage={pageData.finalMessageSection.secondMessage.text}
    thirdMessage={pageData.finalMessageSection.thirdMessage.text}
  />
</MainLayout>
