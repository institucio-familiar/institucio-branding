---
import Layout from '@/layouts/Layout.astro'
import Puncha from '@/components/icons/Puncha.astro'
import PunchaVertical from '@/components/icons/PunchaVertical.astro'
import MediaAsset from '@/components/MediaAsset.astro'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import { HOME_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toMedia } from '@/sanity/lib/utils'
import Icon from '@/components/ui/Icon.astro'
import Mask from '@/components/ui/Mask.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(HOME_PAGE_QUERY)

  // Parse data
  return {
    heroMedia: toMedia(sanityPageData?.hero?.media),
    textSlides: sanityPageData?.textSlides,
    imageZoomMedia: toMedia(sanityPageData?.imageZoom),
    imagesGrid: {
      image1: toMedia(sanityPageData?.imagesGrid?.image1),
      image2: toMedia(sanityPageData?.imagesGrid?.image2),
      image3: toMedia(sanityPageData?.imagesGrid?.image3),
      image4: toMedia(sanityPageData?.imagesGrid?.image4)
    },
    imageEyeMedia: toMedia(sanityPageData?.imageEye),
    bookText: sanityPageData?.bookText,
    words: sanityPageData?.words
  }
}

const pageData = await getPageData()
---

<Layout>
  <section
    class="relative flex min-h-screen items-end justify-left bg-mist px-indent py-15"
  >
    <div class="flex flex-col z-2">
      <h1 class="text-white text-headline-2 uppercase">
        {t('home.hero')}
      </h1>
      <div class="flex items-center gap-2">
        <p class="text-white text-cta">{t('hero.scroll-down')}</p>
        <Icon
          id="scroll-to-bottom-icon"
          name="arrow"
          direction="bottom"
          variant="outline-white"
        />
      </div>
    </div>

    {
      pageData.heroMedia && (
        <MediaAsset
          media={pageData.heroMedia}
          title={t('home.hero')}
          class="absolute inset-0"
        />
      )
    }
  </section>

  <div class="relative h-[200dvh]" data-home-sections>
    <div class="sticky top-0 h-screen">
      <Puncha
        color="navy"
        class="absolute top-[0.5px] left-1/2 z-2 -translate-x-1/2 -translate-y-full"
      />
      <div class="relative h-full clip-x-at-right">
        <section
          class="relative flex h-full items-center justify-center bg-navy p-20"
        >
          <p class="text-blue text-headline-1 uppercase text-center">
            {pageData.textSlides?.textSlide1?.[locale]}
          </p>
        </section>

        <section
          class="absolute inset-0 z-1 h-full"
          data-home-section-2
          style="transform: translateX(100%)"
        >
          <PunchaVertical
            color="blue"
            class="absolute left-[0.5px] top-[50%] -translate-y-1/2 -translate-x-full"
          />
          <div class="flex items-center justify-center p-20 h-full bg-blue">
            <p class="text-navy text-headline-1 uppercase text-center">
              {pageData.textSlides?.textSlide2?.[locale]}
            </p>
          </div>
        </section>
      </div>

      <Puncha
        color="white"
        class="absolute bottom-[-0.5px] left-1/2 z-2 -translate-x-1/2"
      />
    </div>
  </div>

  <section
    class="flex flex-wrap items-center justify-center gap-12 bg-white px-indent py-10 md:py-20"
  >
    <div
      id="mask-zoom"
      class="w-[50vw] min-w-[300px] max-w-[650px]"
      style="transform: scale(0.25)"
    >
      {
        pageData.imageZoomMedia && (
          <Mask type="4o">
            <MediaAsset media={pageData.imageZoomMedia} title={'TESTINGAL'} />
          </Mask>
        )
      }
    </div>
  </section>

  <div data-text-slide-section class="relative h-screen md:h-[200dvh]">
    <section
      class="sticky top-0 flex h-screen items-center justify-center overflow-hidden bg-white p-indent"
    >
      <div id="text-slide-container" class="hidden md:flex flex-col">
        <p
          id="text-slide-1"
          class="text-navy text-headline-1 uppercase"
          style="transform: translateX(-100vw)"
        >
          Per un camí []
        </p>
        <p
          id="text-slide-2"
          class="text-navy text-headline-1 uppercase"
          style="transform: translateX(100vw)"
        >
          que [] ens porta
        </p>
        <p
          id="text-slide-3"
          class="text-navy text-headline-1 uppercase"
          style="transform: translateX(-100vw)"
        >
          ben lluny [] la
        </p>
        <p
          id="text-slide-4"
          class="text-navy text-headline-1 uppercase"
          style="transform: translateX(100vw)"
        >
          nostra guía [] és
        </p>
        <p
          id="text-slide-5"
          class="text-navy text-headline-1 uppercase"
          style="transform: translateX(-100vw)"
        >
          la llum []
        </p>
      </div>
      <!-- <div class="flex flex-col md:hidden">
      <p class="text-navy text-headline-1 uppercase">Per un camí []</p>
      <p class="text-navy text-headline-1 uppercase">que [] ens porta</p>
      <p class="text-navy text-headline-1 uppercase">ben lluny [] la</p>
      <p class="text-navy text-headline-1 uppercase">nostra guía [] és</p>
      <p class="text-navy text-headline-1 uppercase">la llum []</p>
    </div> -->
    </section>
  </div>

  <section
    class="relative flex items-center justify-center bg-white h-screen w-screen px-indent"
  >
    <div class="grid grid-cols-4 w-full">
      {
        pageData.imagesGrid.image1 && (
          <Mask type="tobo" class="w-full h-full col-span-2 row-span-2">
            <MediaAsset media={pageData.imagesGrid.image1} title={t('home.imagesGrid')} />
          </Mask>
        )
      }
      {
        pageData.imagesGrid.image2 && (
          <Mask type="tobobo" class="w-full h-full col-span-2">
            <MediaAsset media={pageData.imagesGrid.image2} title={t('home.imagesGrid')} />
          </Mask>
        )
      }
      {
        pageData.imagesGrid.image3 && (
          <Mask type="tibo" class="w-full h-full">
            <MediaAsset media={pageData.imagesGrid.image3} title={t('home.imagesGrid')} />
          </Mask>
        )
      }
      {
        pageData.imagesGrid.image4 && (
          <Mask type="tibo" class="w-full h-full">
            <MediaAsset media={pageData.imagesGrid.image4} title={t('home.imagesGrid')} />
          </Mask>
        )
      }
    </div>
  </section>

  <section
    class="relative flex items-center justify-center bg-white h-screen w-screen"
  >
    <div class="w-full h-full">
      {
        pageData.imageEyeMedia && (
          <Mask type="tobo_horizontal">
            <MediaAsset media={pageData.imageEyeMedia} title={'TESTINGAL'} />
          </Mask>
        )
      }
    </div>
  </section>

  <section
    class="relative flex items-center justify-center bg-white h-screen w-screen px-indent"
  >
    <div class="w-full h-full">
      <p class="text-navy text-headline-1 uppercase">
        {pageData.bookText?.[locale]}
      </p>
    </div>
  </section>

  <section
    class="relative flex items-center justify-center bg-white h-screen w-screen px-indent"
  >
    <div class="w-full h-full">
      <p class="text-navy text-headline-1 uppercase">
        {pageData.words?.word1?.[locale]}
      </p>
      <p class="text-navy text-headline-1 uppercase">
        {pageData.words?.word2?.[locale]}
      </p>
      <p class="text-navy text-headline-1 uppercase">
        {pageData.words?.word3?.[locale]}
      </p>
    </div>
    <Puncha
      color="white"
      class="absolute bottom-[0.5px] left-1/2 -translate-x-1/2 translate-y-full rotate-180"
    />
  </section>

  <script>
    import { animate, scroll } from 'motion'

    const sectionsBlock = document.querySelector('[data-home-sections]')
    const section2 = document.querySelector('[data-home-section-2]')
    const maskZoom = document.getElementById('mask-zoom')

    const cancelScrolls: Array<() => void> = []

    if (sectionsBlock && section2) {
      const animation = animate(
        section2,
        { transform: ['translateX(100%)', 'translateX(0%)'] },
        { ease: 'linear' }
      )

      cancelScrolls.push(
        scroll(animation, {
          target: sectionsBlock,
          offset: ['start start', 'end end']
        })
      )
    }

    if (maskZoom) {
      const animation = animate(
        maskZoom,
        { scale: [0.25, 1] },
        { ease: 'linear' }
      )

      cancelScrolls.push(
        scroll(animation, {
          target: maskZoom,
          offset: ['start end', 'center center']
        })
      )
    }

    const textSlideSection = document.querySelector('[data-text-slide-section]')
    const textSlides = [
      { id: 'text-slide-1', from: 'translateX(-100vw)' },
      { id: 'text-slide-2', from: 'translateX(100vw)' },
      { id: 'text-slide-3', from: 'translateX(-100vw)' },
      { id: 'text-slide-4', from: 'translateX(100vw)' },
      { id: 'text-slide-5', from: 'translateX(-100vw)' }
    ]

    if (textSlideSection) {
      for (const { id, from } of textSlides) {
        const line = document.getElementById(id)
        if (!line) continue

        const animation = animate(
          line,
          { transform: [from, 'translateX(0)'] },
          { ease: 'linear' }
        )

        cancelScrolls.push(
          scroll(animation, {
            target: textSlideSection,
            offset: ['start start', 'end end']
          })
        )
      }
    }

    document.addEventListener(
      'swup:visit:start',
      () => {
        cancelScrolls.forEach((cancel) => cancel())
      },
      { once: true }
    )
  </script>
</Layout>
