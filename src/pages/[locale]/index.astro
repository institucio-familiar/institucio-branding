---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import Puncha from '@/components/icons/Puncha.astro'
import PunchaVertical from '@/components/icons/PunchaVertical.astro'
import MediaAsset from '@/components/MediaAsset.astro'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import { HOME_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toMedia } from '@/sanity/lib/utils'
import Mask from '@/components/ui/Mask.astro'
import textMask4 from '@/assets/svgs/text_mask_4.svg'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(HOME_PAGE_QUERY)

  // Parse data
  return {
    heroMedia: toMedia(sanityPageData?.hero?.media),
    textSlides: sanityPageData?.textSlides,
    imageZoomMedia: toMedia(sanityPageData?.imageZoom),
    imagesGrid: {
      image1: toMedia(sanityPageData?.imagesGrid?.image1),
      image2: toMedia(sanityPageData?.imagesGrid?.image2),
      image3: toMedia(sanityPageData?.imagesGrid?.image3),
      image4: toMedia(sanityPageData?.imagesGrid?.image4)
    },
    imageEyeMedia: toMedia(sanityPageData?.imageEye),
    bookText: sanityPageData?.bookText,
    words: sanityPageData?.words
  }
}

const pageData = await getPageData()
---

<MainLayout>
  <Hero media={pageData.heroMedia} heading={t('home.hero')} />

  <div class="relative h-[200dvh]" data-home-sections>
    <div class="sticky top-0 h-dvh">
      <Puncha
        color="navy"
        class="absolute top-[0.5px] left-1/2 z-2 -translate-x-1/2 -translate-y-full"
      />
      <div class="relative h-full clip-x-at-right">
        <section
          class="relative flex h-full items-center justify-center bg-navy p-20"
        >
          <p class="text-blue text-headline-1 uppercase text-center">
            {pageData.textSlides?.textSlide1?.[locale]}
          </p>
        </section>

        <section
          class="absolute inset-0 z-1 h-full"
          data-home-section-2
          style="transform: translateX(100%)"
        >
          <PunchaVertical
            color="blue"
            class="absolute left-[0.5px] top-[50%] -translate-y-1/2 -translate-x-full"
          />
          <div class="flex items-center justify-center p-20 h-full bg-blue">
            <p class="text-navy text-headline-1 uppercase text-center">
              {pageData.textSlides?.textSlide2?.[locale]}
            </p>
          </div>
        </section>
      </div>

      <Puncha
        color="white"
        class="absolute bottom-[-0.5px] left-1/2 z-2 -translate-x-1/2"
      />
    </div>
  </div>

  <section
    class="flex flex-wrap items-center justify-center gap-12 bg-white px-indent py-10 md:py-20"
  >
    <div
      id="mask-zoom"
      class="w-[50vw] min-w-[300px] max-w-[650px]"
      style="transform: scale(0.25)"
    >
      {
        pageData.imageZoomMedia && (
          <Mask type="4o" class="w-full">
            <MediaAsset media={pageData.imageZoomMedia} title={'TESTINGAL'} />
          </Mask>
        )
      }
    </div>
  </section>

  <!-- <div data-text-slide-section class="relative h-dvh md:h-[200dvh]">
    <section
      class="sticky top-0 flex h-dvh items-center justify-center overflow-hidden bg-white p-indent"
    >
      <div id="text-slide-container" class="hidden md:flex flex-col">
        <p
          id="text-slide-1"
          class="text-navy text-headline-1 uppercase"
          style="transform: translateX(-100vw)"
        >
          Per un camí []
        </p>
        <p
          id="text-slide-2"
          class="text-navy text-headline-1 uppercase"
          style="transform: translateX(100vw)"
        >
          que [] ens porta
        </p>
        <p
          id="text-slide-3"
          class="text-navy text-headline-1 uppercase"
          style="transform: translateX(-100vw)"
        >
          ben lluny [] la
        </p>
        <p
          id="text-slide-4"
          class="text-navy text-headline-1 uppercase"
          style="transform: translateX(100vw)"
        >
          nostra guía [] és
        </p>
        <p
          id="text-slide-5"
          class="text-navy text-headline-1 uppercase"
          style="transform: translateX(-100vw)"
        >
          la llum []
        </p>
      </div>
    </section>
  </div> -->

  <section data-text-slide-section class="relative h-dvh md:h-[200dvh]">
    <div
      class="sticky top-0 flex h-dvh items-center justify-center overflow-hidden bg-white p-indent"
    >
      <div
        id="text-slide-container"
        class="flex flex-col text-[10vw] lg:text-[8vw] font-serif font-semibold uppercase"
      >
        <div id="text-slide-1" class="flex flex-row gap-4 md:gap-6">
          <p class="shrink-0">Per un camí</p>
          <Mask
            type="tibo_horizontal"
            class="w-[13vw] shrink-0 lg:w-[11vw] translate-y-[-0.5vw]"
          >
            <MediaAsset
              media={{
                mediaType: 'video',
                playbackId: 'w1AiO61GLM9yZWVlvBtoDZZoqsE299slTkUfWMcXCw00'
              }}
            />
          </Mask>
        </div>
        <div id="text-slide-2" class="flex flex-row gap-4 md:gap-6">
          <p class="shrink-0">que</p>
          <Mask
            type="4o"
            class="w-full max-w-[8vw] shrink-0 translate-y-[-6px]"
          >
            <img
              src="https://cdn.sanity.io/images/ryub47of/production/f4ce79b920f9e4ed92beb72d82738b0f29bffc16-1728x2424.png?w=300"
              alt="ens porta"
            />
          </Mask>
          <p class="shrink-0">ens porta</p>
        </div>
        <div id="text-slide-3" class="flex flex-row gap-2">
          <p class="shrink-0">ben lluny</p>
          <div class="relative w-full max-w-[11vw] lg:max-w-[9vw]">
            <img
              src="https://cdn.sanity.io/images/ryub47of/production/bd1225fc754aae5d9278ff44668adf3ec4e6afb1-2048x2080.png?w=300"
              alt="ens porta"
              class="absolute top-0 left-0 w-full max-w-[11vw] lg:max-w-[9vw] translate-y-[-1.5vw] rotate-25"
            />
          </div>
          <p class="shrink-0">la</p>
        </div>
        <div id="text-slide-4" class="flex flex-row gap-2">
          <p class="shrink-0">nostra guía</p>
          <img
            src={textMask4.src}
            alt="ens porta"
            class="w-full max-w-[6vw] lg:max-w-[5vw] translate-y-[-0.5vw]"
          />
          <p class="shrink-0">és</p>
        </div>
        <div id="text-slide-5" class="flex flex-row relative w-fit">
          <p class="shrink-0">la llum</p>
          <img
            src="https://cdn.sanity.io/images/ryub47of/production/3508dd5abbd012e3411d83889b23af4e3af43497-1856x2304.png?w=300"
            alt="ens porta"
            class="w-full absolute top-[-4vw] right-[-10vw] lg:right-[-8vw] max-w-[12vw] lg:max-w-[10vw]"
          />
        </div>
      </div>
    </div>
  </section>

  <div class="text-macro uppercase text-nowrap">
    Desde 1970 acompañando familias
  </div>

  <section
    class="relative flex items-center justify-center bg-white h-dvh w-screen px-indent"
  >
    <div class="grid grid-cols-4 w-full">
      {
        pageData.imagesGrid.image1 && (
          <Mask type="tobo" class="w-full h-full col-span-2 row-span-2">
            <MediaAsset
              media={pageData.imagesGrid.image1}
              title={t('home.imagesGrid')}
            />
          </Mask>
        )
      }
      {
        pageData.imagesGrid.image2 && (
          <Mask type="tobobo" class="w-full h-full col-span-2">
            <MediaAsset
              media={pageData.imagesGrid.image2}
              title={t('home.imagesGrid')}
            />
          </Mask>
        )
      }
      {
        pageData.imagesGrid.image3 && (
          <Mask type="tibo" class="w-full h-full">
            <MediaAsset
              media={pageData.imagesGrid.image3}
              title={t('home.imagesGrid')}
            />
          </Mask>
        )
      }
      {
        pageData.imagesGrid.image4 && (
          <Mask type="tibo" class="w-full h-full">
            <MediaAsset
              media={pageData.imagesGrid.image4}
              title={t('home.imagesGrid')}
            />
          </Mask>
        )
      }
    </div>
  </section>

  <section
    class="relative flex items-center justify-center bg-white h-dvh w-screen"
  >
    <div class="w-full h-full">
      {
        pageData.imageEyeMedia && (
          <Mask type="tobo_horizontal" class="h-full w-full">
            <MediaAsset media={pageData.imageEyeMedia} title={'TESTINGAL'} />
          </Mask>
        )
      }
    </div>
  </section>

  <section class="relative flex items-center justify-center bg-white px-indent">
    <div class="w-full h-full">
      <p class="text-navy text-headline-3 uppercase">
        {pageData.bookText?.[locale]}
      </p>
    </div>
  </section>

  <section class="relative flex items-center justify-center bg-white px-indent">
    <!-- <div class="w-full h-full">
      <p class="text-navy text-macro uppercase">
        {pageData.words?.word1?.[locale]}
      </p>
      <p class="text-navy text-macro uppercase">
        {pageData.words?.word2?.[locale]}
      </p>
      <p class="text-navy text-macro uppercase">
        {pageData.words?.word3?.[locale]}
      </p>
    </div> -->
    <Puncha
      color="white"
      class="absolute bottom-[0.5px] left-1/2 -translate-x-1/2 translate-y-full rotate-180"
    />
  </section>
</MainLayout>

<script>
  import { gsap } from 'gsap'

  const tweens: gsap.core.Tween[] = []

  const sectionsBlock = document.querySelector('[data-home-sections]')
  const section2 = document.querySelector('[data-home-section-2]')
  const maskZoom = document.getElementById('mask-zoom')
  const textSlideSection = document.querySelector('[data-text-slide-section]')

  if (sectionsBlock && section2) {
    tweens.push(
      gsap.fromTo(
        section2,
        { x: '100%' },
        {
          x: '0%',
          ease: 'ease-out',
          scrollTrigger: {
            trigger: sectionsBlock,
            start: 'top top',
            end: 'bottom bottom',
            scrub: true
          }
        }
      )
    )
  }

  if (maskZoom) {
    tweens.push(
      gsap.fromTo(
        maskZoom,
        { scale: 0.25 },
        {
          scale: 1,
          ease: 'ease-out',
          scrollTrigger: {
            trigger: maskZoom,
            start: 'top bottom',
            end: 'center center',
            scrub: true
          }
        }
      )
    )
  }

  const textSlides = [
    { id: 'text-slide-1', from: '-100vw' },
    { id: 'text-slide-2', from: '100vw' },
    { id: 'text-slide-3', from: '-100vw' },
    { id: 'text-slide-4', from: '100vw' },
    { id: 'text-slide-5', from: '-100vw' }
  ]

  if (textSlideSection) {
    for (const { id, from } of textSlides) {
      const line = document.getElementById(id)
      if (!line) continue

      tweens.push(
        gsap.fromTo(
          line,
          { x: from },
          {
            x: 0,
            ease: 'ease-out',
            scrollTrigger: {
              trigger: textSlideSection,
              start: 'top bottom',
              end: 'bottom bottom',
              scrub: true
            }
          }
        )
      )
    }
  }

  document.addEventListener(
    'swup:visit:start',
    () => {
      tweens.forEach((tween) => {
        tween.scrollTrigger?.kill()
        tween.kill()
      })
    },
    { once: true }
  )
</script>
