---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { ILUSTRACION_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toMedia } from '@/sanity/lib/utils'
import {
  parsePageHeader,
  toAtom1,
  toBadUses,
  toMediaDescriptionBlocks
} from '@/sanity/lib/page-parsers'
import { Block8 } from '@/components/ui/blocks'
import PageAsideLayout from '@/layouts/page-aside/PageAsideLayout.astro'
import Section from '@/layouts/page-aside/PageAsideSection.astro'
import { toLocaleString } from '@/sanity/lib/page-parsers'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(ILUSTRACION_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    introMedia: toMedia(sanityPageData?.intro?.media),
    section1: sanityPageData?.section1
      ? {
          title: toLocaleString(sanityPageData.section1.title, locale),
          description: sanityPageData.section1.description?.[locale]
        }
      : {
          title: '',
          description: ''
        },
    section2: toAtom1(sanityPageData?.section2, locale),
    section3: toAtom1(sanityPageData?.section3, locale),
    section4: toAtom1(sanityPageData?.section4, locale),
    section5: sanityPageData?.section5
      ? {
          title: toLocaleString(sanityPageData.section5.title, locale),
          description: sanityPageData.section5.description?.[locale],
          blocks: toMediaDescriptionBlocks(
            sanityPageData.section5.blocks,
            locale
          )
        }
      : {
          title: '',
          description: '',
          blocks: []
        },
    section6: toAtom1(sanityPageData?.section6, locale),
    section7: sanityPageData?.section7
      ? {
          title: toLocaleString(sanityPageData.section7.title, locale),
          description: sanityPageData.section7.description?.[locale],
          instructions: sanityPageData.section7.instructions
            ? {
                title: sanityPageData.section7.instructions.title?.[locale],
                description:
                  sanityPageData.section7.instructions.description?.[locale],
                prompt: sanityPageData.section7.instructions.prompt
              }
            : null
        }
      : {
          title: '',
          description: '',
          instructions: null
        },
    section8: toBadUses(sanityPageData?.section8, locale)
  }
}

const pageData = await getPageData()

const colors = [
  { hex: '#6FA8DC', rgb: '111 / 168 / 220', cmyk: '50 / 24 / 0 / 14' },
  { hex: '#A9D3F5', rgb: '169 / 211 / 245', cmyk: '31 / 14 / 0 / 4' },
  { hex: '#3F5FA8', rgb: '63 / 95 / 168', cmyk: '63 / 43 / 0 / 34' },
  { hex: '#4F6F8C', rgb: '79 / 111 / 140', cmyk: '44 / 21 / 0 / 45' },
  { hex: '#E5C85B', rgb: '229 / 200 / 91', cmyk: '0 / 13 / 60 / 10' },
  { hex: '#F2E18B', rgb: '242 / 225 / 139', cmyk: '0 / 7 / 43 / 5' },
  { hex: '#B88A3D', rgb: '184 / 138 / 61', cmyk: '0 / 25 / 67 / 28' },
  { hex: '#2B2B2B', rgb: '43 / 43 / 43', cmyk: '0 / 0 / 0 / 83' },
  { hex: '#7FBE73', rgb: '127 / 190 / 115', cmyk: '33 / 0 / 39 / 25' },
  { hex: '#B7D98A', rgb: '183 / 217 / 138', cmyk: '16 / 0 / 36 / 15' },
  { hex: '#9ED9C3', rgb: '158 / 217 / 195', cmyk: '27 / 0 / 10 / 15' },
  { hex: '#5D7F4F', rgb: '93 / 127 / 79', cmyk: '27 / 0 / 38 / 50' },
  { hex: '#7A7B45', rgb: '122 / 123 / 69', cmyk: '1 / 0 / 44 / 52' },
  { hex: '#D9786F', rgb: '217 / 120 / 111', cmyk: '0 / 45 / 49 / 15' },
  { hex: '#D9908A', rgb: '217 / 144 / 138', cmyk: '0 / 34 / 36 / 15' },
  { hex: '#C94E4B', rgb: '201 / 78 / 75', cmyk: '0 / 61 / 63 / 21' },
  { hex: '#8E2E2C', rgb: '142 / 46 / 44', cmyk: '0 / 68 / 69 / 44' },
  { hex: '#B56745', rgb: '181 / 103 / 69', cmyk: '0 / 43 / 62 / 29' },
  { hex: '#D99A5E', rgb: '217 / 154 / 94', cmyk: '0 / 29 / 57 / 15' },
  { hex: '#E7B18D', rgb: '231 / 177 / 141', cmyk: '0 / 23 / 39 / 9' },
  { hex: '#B89ACB', rgb: '184 / 154 / 203', cmyk: '9 / 24 / 0 / 20' },
  { hex: '#8E7A9E', rgb: '142 / 122 / 158', cmyk: '10 / 23 / 0 / 38' },
  { hex: '#E8D7BF', rgb: '232 / 215 / 191', cmyk: '0 / 7 / 18 / 9' },
  { hex: '#DCC39E', rgb: '220 / 195 / 158', cmyk: '0 / 11 / 28 / 14' },
  { hex: '#8B5E3C', rgb: '139 / 94 / 60', cmyk: '0 / 32 / 57 / 45' },
  { hex: '#5C4638', rgb: '92 / 70 / 56', cmyk: '0 / 24 / 39 / 64' },
  { hex: '#F3F0E8', rgb: '243 / 240 / 232', cmyk: '0 / 1 / 5 / 5' },
  { hex: '#CFCFCA', rgb: '207 / 207 / 202', cmyk: '0 / 0 / 2 / 19' },
  { hex: '#A7A7A2', rgb: '167 / 167 / 162', cmyk: '0 / 0 / 3 / 35' },
  { hex: '#7F7F7A', rgb: '127 / 127 / 122', cmyk: '0 / 0 / 4 / 50' }
]

function getContrastTextClass(hex: string) {
  const r = parseInt(hex.slice(1, 3), 16)
  const g = parseInt(hex.slice(3, 5), 16)
  const b = parseInt(hex.slice(5, 7), 16)
  return (0.299 * r + 0.587 * g + 0.114 * b) / 255 > 0.5
    ? 'text-ink'
    : 'text-white'
}

const colorRowSizes = [4, 4, 5, 5, 2, 2, 4, 5]

let colorOffset = 0
const colorRows = colorRowSizes.map((size) => {
  const row = colors.slice(colorOffset, colorOffset + size)
  colorOffset += size
  return row
})

const asideSections = [
  { id: 'section1', label: pageData.section1.title },
  { id: 'section2', label: pageData.section2?.title || '' }, // TESTINGAL > Avoid this from being null
  { id: 'section3', label: pageData.section3?.title || '' }, // TESTINGAL > Avoid this from being null
  { id: 'section4', label: pageData.section4?.title || '' }, // TESTINGAL > Avoid this from being null
  { id: 'section5', label: pageData.section5.title },
  { id: 'section6', label: pageData.section6?.title || '' }, // TESTINGAL > Avoid this from being null
  { id: 'section7', label: pageData.section7.title },
  { id: 'section8', label: pageData.section8.title }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-page-title">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/ilustracion">
    <Section class="pb-8">
      <p class="text-page-description">
        {pageData.pageDescription}
      </p>
    </Section>
    <Section id="section1" class="pb-8">
      <div class="flex flex-col gap-3 md:gap-6">
        {
          colorRows.map((row) => (
            <div class="grid grid-cols-5 gap-3 md:gap-6">
              {row.map((color) => (
                <div
                  class={`flex aspect-2/1 flex-col justify-end rounded-sm p-3 ${getContrastTextClass(color.hex)}`}
                  style={{ backgroundColor: color.hex }}
                >
                  <p class="text-small">{color.hex}</p>
                  <p class="text-small">RGB {color.rgb}</p>
                  <p class="text-small">CMYK {color.cmyk}</p>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </Section>

    <Section id="section8" class="pb-12 md:pb-20">
      <Block8
        title={pageData.section8.title}
        description={pageData.section8.description}
        items={pageData.section8.items}
      />
    </Section>
  </PageAsideLayout>
</MainLayout>
