---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { ILUSTRACION_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toMedia } from '@/sanity/lib/utils'
import Block7 from '@/components/ui/blocks/Block-7.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(ILUSTRACION_PAGE_QUERY)

  // Parse data
  return {
    heroMedia: toMedia(sanityPageData?.hero?.media),
    pageTitle: sanityPageData?.intro?.title?.[locale],
    pageDescription: sanityPageData?.intro?.description?.[locale]
  }
}

const pageData = await getPageData()

const colors = [
