---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import Puncha from '@/components/icons/Puncha.astro'
import PageAsideLayout from '@/components/PageAsideLayout.astro'
import Block1 from '@/components/ui/blocks/Block-1.astro'
import Block2 from '@/components/ui/blocks/Block-2.astro'
import Block3 from '@/components/ui/blocks/Block-3.astro'
import Block4 from '@/components/ui/blocks/Block-4.astro'
import Block5 from '@/components/ui/blocks/Block-5.astro'
import Block6 from '@/components/ui/blocks/Block-6.astro'
import Block7 from '@/components/ui/blocks/Block-7.astro'
import type { Media } from '@/components/ui/blocks/block-types'

const fakeMedia: Media = {
  mediaType: 'offline',
  imageSrc: '/dev.jpg'
}

const fakePageData = {
  heroMedia: fakeMedia,
  title: 'Cercanos',
  description:
    'Hablamos de tú a tú, con naturalidad, empatía y respeto. Queremos que alumnos y familias sientan que detrás de cada mensaje hay personas reales acompañándolas en su día a día. No buscamos sonar institucionales ni distantes. Buscamos conectar.',
  blocks: [
    { type: 'block_1', block: { media1: fakeMedia } },
    { type: 'block_2', block: { media1: fakeMedia, media2: fakeMedia } }
  ],
  badCases: {
    title: 'Malos usos',
    description:
      'Cuando la identidad de Turó convive con otras marcas, debe aplicarse de forma clara y consistente, respetando las jerarquías visuales y garantizando una correcta identificación de todas las entidades participantes.',
    items: Array.from({ length: 6 }, () => ({
      media: fakeMedia,
      description: 'No añadir contornos al logotipo'
    }))
  }
}

async function getPageData() {
  return fakePageData
}

const pageData = await getPageData()
const heroMedia = pageData.heroMedia

const asideSections = [
  { id: 'block-1', label: 'Block 1' },
  { id: 'block-2', label: 'Block 2' },
  { id: 'block-3', label: 'Block 3' },
  { id: 'block-4', label: 'Block 4' },
  { id: 'block-5', label: 'Block 5' },
  { id: 'block-6', label: 'Block 6' },
  { id: 'block-7', label: 'Block 7' }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.title} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-navy text-headline-1 uppercase py-indent-2">Blocks</h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/blocks">
    <div id="block-1" class="py-10">
      <p class="text-headline-3 pb-3 text-navy-light">Block 1</p>
      {heroMedia && <Block1 media1={heroMedia} />}
    </div>
    <div id="block-2" class="py-10">
      <p class="text-headline-3 pb-3 text-navy-light">Block 2</p>
      {heroMedia && <Block2 media1={heroMedia} media2={heroMedia} />}
    </div>
    <div id="block-3" class="py-10">
      <p class="text-headline-3 pb-3 text-navy-light">Block 3</p>
      {
        heroMedia && (
          <Block3
            title={pageData.title}
            description={pageData.description}
            media={heroMedia}
          />
        )
      }
    </div>
    <div id="block-4" class="py-10">
      <p class="text-headline-3 pb-3 text-navy-light">Block 4</p>
      {
        heroMedia && (
          <Block4
            title={pageData.title}
            description={pageData.description}
            media={heroMedia}
          />
        )
      }
    </div>
    <div id="block-5" class="py-10">
      <p class="text-headline-3 pb-3 text-navy-light">Block 5</p>
      {
        heroMedia && (
          <Block5
            title={pageData.title}
            description={pageData.description}
            medias={[heroMedia, heroMedia]}
          />
        )
      }
    </div>
    <div id="block-6" class="py-10">
      <p class="text-headline-3 pb-3 text-navy-light">Block 6</p>
      {
        heroMedia && (
          <Block6
            title={pageData.title}
            description={pageData.description}
            media={heroMedia}
          />
        )
      }
    </div>
    <div id="block-7" class="py-10">
      <p class="text-headline-3 pb-3 text-navy-light">Block 7</p>
      {
        heroMedia && (
          <Block7
            title={pageData.badCases.title}
            description={pageData.description}
            items={pageData.badCases.items}
          />
        )
      }
    </div>
  </PageAsideLayout>

  <section
    class="relative flex items-center justify-center bg-white border-t border-navy-light py-10 md:py-20 min-h-[60vh]"
  >
    <p class="text-ink text-headline-3">Final</p>
    <Puncha
      color="white"
      class="absolute bottom-[0.5px] left-1/2 -translate-x-1/2 translate-y-full rotate-180"
    />
  </section>
</MainLayout>
