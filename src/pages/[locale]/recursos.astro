---
import MainLayout from '@/layouts/MainLayout.astro'
import MediaAsset from '@/components/MediaAsset.astro'
import Card from '@/components/ui/Card.astro'
import Icon from '@/components/ui/Icon.astro'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import Puncha from '@/components/icons/Puncha.astro'
import { RECURSOS_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toMedia } from '@/sanity/lib/utils'
import type { Media } from '@/components/ui/blocks/block-types'

type RecursosCard = {
  title: string
  description: string
  buttonUrl: string
  media: Media
}

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(RECURSOS_PAGE_QUERY)

  // Parse data
  return {
    heroMedia: toMedia(sanityPageData?.hero?.media),
    pageTitle: sanityPageData?.intro?.title?.[locale],
    pageDescription: sanityPageData?.intro?.description?.[locale],
    section1:
      sanityPageData?.section1?.map((item: any) => ({
        title: item.title[locale],
        description: item.description[locale],
        buttonUrl: item.url,
        media: toMedia(item.media)
      })) ?? []
  }
}

const pageData = await getPageData()
---

<MainLayout>
  <section
    class="flex min-h-screen items-end justify-left bg-mist px-indent py-15 relative"
  >
    <div class="flex flex-col z-2">
      <div class="flex items-center gap-2">
        <p class="text-white text-cta">{t('hero.scroll-down')}</p>
        <Icon
          id="scroll-to-bottom-icon"
          name="arrow"
          direction="bottom"
          variant="outline-white"
        />
      </div>
    </div>

    {
      pageData.heroMedia && (
        <MediaAsset
          media={pageData.heroMedia}
          title={pageData.pageTitle}
          class="absolute inset-0"
          imageSize={1920}
        />
      )
    }
  </section>

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-navy text-headline-1 uppercase py-indent-2">
      {pageData.pageTitle}
    </h1>
  </section>

  {
    pageData.section1.length > 0 && (
      <section class="grid grid-cols-1 gap-indent bg-white px-indent pb-indent-2 md:grid-cols-2">
        {pageData.section1.map((item: RecursosCard) => (
          <Card
            title={item.title}
            media={item.media}
            description={item.description}
            buttonUrl={item.buttonUrl}
          >
            <span slot="button">{t('recursos.download')}</span>
          </Card>
        ))}
      </section>
    )
  }
</MainLayout>
