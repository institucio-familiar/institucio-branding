---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import Card from '@/components/ui/Card.astro'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import Puncha from '@/components/icons/Puncha.astro'
import PageAsideLayout from '@/layouts/page-aside/PageAsideLayout.astro'
import Section from '@/layouts/page-aside/PageAsideSection.astro'
import { RECURSOS_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { parsePageHeader } from '@/sanity/lib/page-parsers'
import { toMedia } from '@/sanity/lib/utils'
import type { Media } from '@/components/ui/blocks/block-types'

type RecursosCard = {
  title: string
  description: string
  buttonUrl: string
  media: Media
}

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(RECURSOS_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    section1: (sanityPageData?.section1 ?? [])
      .map((item) => {
        const media = toMedia(item.media)
        const title = item.title?.[locale]
        const description = item.description?.[locale]
        if (!media || !item.url || !title || !description) return null

        return {
          title,
          description,
          buttonUrl: item.url,
          media
        }
      })
      .filter((item): item is RecursosCard => item !== null)
  }
}

const pageData = await getPageData()

const asideSections = [{ id: 'section1', label: 'Recursos' }]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-page-title">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/recursos">
    <Section class="pb-8 md:pb-16">
      <p class="text-page-description">
        {pageData.pageDescription}
      </p>
    </Section>
    {
      pageData.section1.length > 0 && (
        <Section id="section1" class="pb-8 md:pb-16">
          <h2 class="text-navy text-headline-2 uppercase pb-4 md:pb-6">
            {t('recursos.assets')}
          </h2>
          <div class="grid grid-cols-1 gap-indent pb-8 md:grid-cols-2">
            {pageData.section1.map((item: RecursosCard) => (
              <Card
                title={item.title}
                media={item.media}
                description={item.description}
                buttonUrl={item.buttonUrl}
              />
            ))}
          </div>
        </Section>
      )
    }
  </PageAsideLayout>
</MainLayout>
