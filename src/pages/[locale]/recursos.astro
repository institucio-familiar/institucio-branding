---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import Card from '@/components/ui/Card.astro'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import Puncha from '@/components/icons/Puncha.astro'
import PageAsideLayout from '@/layouts/page-aside/PageAsideLayout.astro'
import Section from '@/layouts/page-aside/PageAsideSection.astro'
import { RECURSOS_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { parsePageHeader, toLinkedMediaCards } from '@/sanity/lib/page-parsers'
import { slugify } from '@/src/lib/utils'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(RECURSOS_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    section1: toLinkedMediaCards(sanityPageData?.section1, locale)
  }
}

const pageData = await getPageData()

const asideSections = ['Recursos'].map((label) => ({
  id: slugify(label),
  label
}))
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-page-title">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/recursos">
    <Section class="pb-8 md:pb-16">
      <p class="text-page-description">
        {pageData.pageDescription}
      </p>
    </Section>
    {
      pageData.section1.length > 0 && (
        <Section id={asideSections[0].id} class="pb-8 md:pb-16">
          <h2 class="text-navy text-headline-2 uppercase pb-4 md:pb-6">
            {t('recursos.assets')}
          </h2>
          <div
            class="grid grid-cols-1 gap-indent pb-8 md:grid-cols-2"
            data-reveal-in-view
          >
            {pageData.section1.map((item) => (
              <Card
                title={item.title}
                media={item.media}
                description={item.description}
                buttonUrl={item.buttonUrl}
              />
            ))}
          </div>
        </Section>
      )
    }
  </PageAsideLayout>
</MainLayout>
