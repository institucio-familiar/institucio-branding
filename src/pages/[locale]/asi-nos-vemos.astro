---
import MainLayout from '@/layouts/MainLayout.astro'
import MediaAsset from '@/components/MediaAsset.astro'
import Icon from '@/components/ui/Icon.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import Puncha from '@/components/icons/Puncha.astro'
import { ASI_NOS_VEMOS_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toBlock, toMedia, type SanityBlockData } from '@/sanity/lib/utils'
import type { BlockData } from '@/components/ui/blocks/block-types'
import Block from '@/components/ui/blocks/Block.astro'
import ScrollToButton from '@/components/ScrollToButton.astro'
import { ASI_NOS_VEMOS_SECTIONS } from '@/constants'
import Button from '@/components/ui/Button.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(ASI_NOS_VEMOS_PAGE_QUERY)

  // Parse data
  return {
    heroMedia: toMedia(sanityPageData?.hero?.media),
    pageTitle: sanityPageData?.intro?.title?.[locale],
    pageDescription: sanityPageData?.intro?.description?.[locale],
    sections: Object.values(ASI_NOS_VEMOS_SECTIONS).map((section) => {
      const sanityBlocks: SanityBlockData[] =
        sanityPageData?.sections?.[section.key] ?? []

      return {
        id: section.id,
        blocks: sanityBlocks
          .map(toBlock)
          .filter((block): block is BlockData => block !== null)
      }
    })
  }
}

const pageData = await getPageData()
---

<MainLayout>
  {
    pageData.heroMedia && (
      <div
        data-hero-media
        class="pointer-events-none fixed inset-0 -z-1 h-screen w-full"
      >
        <MediaAsset
          media={pageData.heroMedia}
          title={pageData.pageTitle}
          class="absolute inset-0"
          imageSize={1920}
        />
      </div>
    )
  }

  <section
    class="relative flex min-h-screen items-end justify-left px-indent py-15"
    data-hero-section
  >
    <div class="flex flex-col">
      <div class="flex items-center gap-2">
        <p class="text-white text-cta">{t('hero.scroll-down')}</p>
        <Icon
          id="scroll-to-bottom-icon"
          name="arrow"
          direction="bottom"
          variant="outline-white"
        />
      </div>
    </div>
  </section>

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-navy text-headline-1 uppercase py-indent-2">
      {pageData.pageTitle}
    </h1>
  </section>

  <div class="relative grid grid-cols-12 gap-2 bg-white px-indent">
    <aside class="col-span-2 sticky top-nav-height self-start pb-8">
      <div class="flex flex-col gap-2">
        {
          pageData.sections.map((section) => (
            <ScrollToButton
              targetId={section.id}
              href={getRelativeLocaleUrl(
                locale,
                `/asi-nos-vemos#${section.id}`
              )}
              class="text-navy text-body hover:text-body-bold"
            >
              {t(`asi-nos-vemos.${section.id}`)}
            </ScrollToButton>
          ))
        }
      </div>
    </aside>
    <div class="col-span-10">
      <section class="pb-indent">
        <p class="text-navy text-headline-3">
          {pageData.pageDescription}
        </p>
      </section>
      {
        pageData.sections.map((section) => (
          <section id={section.id} class="pb-indent flex flex-col gap-indent">
            <div class="flex items-center justify-between">
              <p class="text-navy text-headline-2">
                {t(`asi-nos-vemos.${section.id}`)}
              </p>
              {section.id !== 'asi-nos-vemos' ? (
                <Button
                  href={getRelativeLocaleUrl(locale, `/${section.id}`)}
                  variant="secondary-white"
                >
                  {t(`asi-nos-vemos.go-to.${section.id}`)}
                </Button>
              ) : null}
            </div>
            {section.blocks?.map((block) => (
              <Block {...block} />
            ))}
          </section>
        ))
      }
    </div>
  </div>

  <script>
    import { animate, scroll } from 'motion'

    const heroSection = document.querySelector('[data-hero-section]')
    const heroMedia = document.querySelector('[data-hero-media]')
    const cancelScrolls: Array<() => void> = []

    // if (heroSection && heroMedia) {
    //   const animation = animate(
    //     heroMedia,
    //     { opacity: [1, 0.35] },
    //     { ease: 'linear' }
    //   )

    //   cancelScrolls.push(
    //     scroll(animation, {
    //       target: heroSection,
    //       offset: ['start start', 'end start']
    //     })
    //   )
    // }

    // document.addEventListener(
    //   'swup:visit:start',
    //   () => {
    //     cancelScrolls.forEach((cancel) => cancel())
    //   },
    //   { once: true }
    // )
  </script>
</MainLayout>
