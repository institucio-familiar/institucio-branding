---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import Puncha from '@/components/icons/Puncha.astro'
import { ASI_NOS_VEMOS_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { parsePageHeader, toBlocks } from '@/sanity/lib/page-parsers'
import type { SanityBlockData } from '@/sanity/lib/utils'
import { Block } from '@/components/ui/blocks'
import PageAsideLayout from '@/components/PageAsideLayout.astro'
import { ASI_NOS_VEMOS_SECTIONS } from '@/constants'
import Button from '@/components/ui/Button.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(ASI_NOS_VEMOS_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    sections: Object.values(ASI_NOS_VEMOS_SECTIONS).map((section) => {
      const sanityBlocks: SanityBlockData[] =
        sanityPageData?.sections?.[section.key] ?? []

      return {
        id: section.id,
        blocks: toBlocks(sanityBlocks)
      }
    })
  }
}

const pageData = await getPageData()

const asideSections = pageData.sections.map((section) => ({
  id: section.id,
  label: t(`asi-nos-vemos.${section.id}`)
}))
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-navy text-headline-1 uppercase py-indent-2">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/asi-nos-vemos">
    <section class="pb-indent">
      <p class="text-navy text-headline-3">
        {pageData.pageDescription}
      </p>
    </section>
    {
      pageData.sections.map((section) => (
        <section id={section.id} class="pb-indent flex flex-col gap-indent">
          <div class="flex items-center justify-between">
            <p class="text-navy text-headline-2">
              {t(`asi-nos-vemos.${section.id}`)}
            </p>
            {section.id !== 'asi-nos-vemos' ? (
              <Button
                href={getRelativeLocaleUrl(locale, `/${section.id}`)}
                variant="secondary-white"
              >
                {t(`asi-nos-vemos.go-to.${section.id}`)}
              </Button>
            ) : null}
          </div>
          {section.blocks?.map((block) => (
            <Block {...block} />
          ))}
        </section>
      ))
    }
  </PageAsideLayout>
</MainLayout>
