---
import Layout from '@/layouts/Layout.astro'
import MediaAsset from '@/components/MediaAsset.astro'
import Icon from '@/components/ui/Icon.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import Puncha from '@/components/icons/Puncha.astro'
import { ASI_NOS_VEMOS_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toBlock } from '@/sanity/lib/utils'
import type { BlockData } from '@/components/ui/blocks/block-types'
import Block from '@/components/ui/blocks/Block.astro'
import { ASI_NOS_VEMOS_SECTIONS } from '@/constants'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

const pageData = await sanityClient.fetch(ASI_NOS_VEMOS_PAGE_QUERY)
const heroMedia = pageData?.hero?.media
const pageTitle = pageData?.hero?.title?.[locale]
const pageDescription = pageData?.hero?.description?.[locale]

const sections = Object.values(ASI_NOS_VEMOS_SECTIONS).map((section) => ({
  id: section.id,
  blocks:
    pageData?.sections?.[section.key]
      ?.map(toBlock)
      .filter((block): block is BlockData => block !== null) ?? []
}))
---

<Layout>
  <section
    class="flex min-h-screen items-end justify-left bg-mist px-indent py-15 relative"
  >
    <div class="flex flex-col z-2">
      <div class="flex items-center gap-2">
        <p class="text-white text-cta">{t('hero.scroll-down')}</p>
        <Icon
          id="scroll-to-bottom-icon"
          name="arrow"
          direction="bottom"
          variant="outline-white"
        />
      </div>
    </div>

    {
      heroMedia && (
        <MediaAsset
          mediaType={heroMedia.mediaType}
          title={pageTitle}
          image={heroMedia.image}
          playbackId={heroMedia.video?.asset?.playbackId}
          class="absolute inset-0"
        />
      )
    }
  </section>

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-navy text-headline-1 uppercase py-indent-2">
      {pageTitle}
    </h1>
  </section>

  <div class="grid grid-cols-12 gap-2 px-indent bg-white">
    <aside class="col-span-2">
      <div class="flex flex-col gap-3">
        {
          sections.map((section) => (
            <a
              href={getRelativeLocaleUrl(locale, `#${section.id}TESTINGAL`)}
              class="text-navy text-body hover:text-body-bold"
            >
              {t(`asi-nos-vemos.${section.id}`)}
            </a>
          ))
        }
      </div>
    </aside>
    <div class="col-span-10">
      <section class="pb-indent">
        <p class="text-navy text-headline-3">
          {pageDescription}
        </p>
      </section>
      {
        sections.map((section) => (
          <section id={section.id} class="pb-indent flex flex-col gap-indent">
            <div class="flex items-center justify-between">
              <p class="text-navy text-headline-2">
                {t(`asi-nos-vemos.${section.id}`)}
              </p>
              {section.id !== 'asi-nos-vemos' ? (
                <a
                  href={getRelativeLocaleUrl(locale, `/${section.id}`)}
                  class="text-navy text-body"
                >
                  Ir a página (TESTINGAL)
                </a>
              ) : null}
            </div>
            {section.blocks?.map((block: BlockData) => (
              <Block block={block} />
            ))}
          </section>
        ))
      }
    </div>
  </div>
</Layout>
