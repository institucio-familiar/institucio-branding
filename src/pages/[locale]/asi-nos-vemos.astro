---
import Layout from '@/layouts/Layout.astro'
import MediaAsset from '@/components/MediaAsset.astro'
import Icon from '@/components/ui/Icon.astro'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import Puncha from '@/components/icons/Puncha.astro'
import { ASI_NOS_VEMOS_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toBlock } from '@/sanity/lib/utils'
import type { BlockData } from '@/components/ui/blocks/block-types'
import Block from '@/components/ui/blocks/Block.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

const pageData = await sanityClient.fetch(ASI_NOS_VEMOS_PAGE_QUERY)
console.log(pageData)
const heroMedia = pageData?.hero?.media
const pageTitle = pageData?.hero?.title?.[locale]
const pageDescription = pageData?.hero?.description?.[locale]

// const generalBlocks =
//   pageData?.generalBlocks
//     ?.map(toBlock)
//     .filter((block: BlockData): block is BlockData => block !== null) ?? []
---

<Layout>
  <section
    class="flex min-h-screen items-end justify-left bg-mist px-indent py-15 relative"
  >
    <div class="flex flex-col z-2">
      <h1 class="text-white text-headline-2 uppercase">
        {pageTitle}
      </h1>
      <div class="flex items-center gap-2">
        <p class="text-white text-body">{t('hero.scroll-down')}</p>
        <Icon
          id="scroll-to-bottom-icon"
          name="arrow"
          direction="bottom"
          variant="outline-white"
        />
      </div>
    </div>

    {
      heroMedia && (
        <MediaAsset
          mediaType={heroMedia.mediaType}
          title={pageTitle}
          image={heroMedia.image}
          playbackId={heroMedia.video?.asset?.playbackId}
          class="absolute inset-0"
        />
      )
    }
  </section>

  <section
    class="relative flex min-h-screen items-center justify-center bg-white p-20"
  >
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <p class="text-navy text-headline-1 uppercase text-center">
      {pageDescription}
    </p>
  </section>

  <!-- <section
    class="relative flex min-h-screen items-center justify-center bg-white p-20"
  >
    {generalBlocks.map((block: BlockData) => <Block block={block} />)}
  </section> -->
</Layout>
