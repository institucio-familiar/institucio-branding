---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { BRAND_COLORS_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import {
  parsePageHeader,
  toAtom1,
  toAtom2,
  toBadUses,
  toSectionWithAtom2Blocks
} from '@/sanity/lib/page-parsers'
import { Block4, Block5, Block7 } from '@/components/ui/blocks'
import PageAsideLayout from '@/layouts/page-aside/PageAsideLayout.astro'
import Section from '@/layouts/page-aside/PageAsideSection.astro'
import { toLocaleString } from '@/sanity/lib/page-parsers'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(BRAND_COLORS_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    section1: toAtom2(sanityPageData?.section1, locale),
    section2: toAtom2(sanityPageData?.section2, locale),
    section3: sanityPageData?.section3
      ? {
          title: toLocaleString(sanityPageData.section3.title, locale),
          description: sanityPageData.section3.description?.[locale],
          percentages: toAtom1(sanityPageData.section3.percentages, locale)
        }
      : {
          title: '',
          description: '',
          percentages: null
        },
    section4: toSectionWithAtom2Blocks(sanityPageData?.section4, locale),
    section5: toBadUses(sanityPageData?.section5, locale)
  }
}

const pageData = await getPageData()

type BrandColor = {
  name: string
  textColor: string
  hex: string
  rgb: string
  cmyk: string
  pantone?: string
}

const COLORS: Record<string, BrandColor> = {
  WHITE: {
    name: 'white',
    textColor: 'ink',
    hex: '#F7F7F7',
    rgb: '247 / 247 / 247',
    cmyk: '0 / 0 / 0 / 3'
  },
  INK: {
    name: 'ink',
    textColor: 'gray',
    hex: '#040D1A',
    rgb: '4 / 13 / 26',
    cmyk: '85 / 50 / 0 / 90',
    pantone: '296 C'
  },
  GRAY: {
    name: 'gray',
    textColor: 'blue',
    hex: '#EEEEEE',
    rgb: '238 / 238 / 238',
    cmyk: '0 / 0 / 0 / 7',
    pantone: 'Cool Gray 1 C'
  },
  BLUE: {
    name: 'blue',
    textColor: 'gray',
    hex: '#1469FF',
    rgb: '20 / 105 / 255',
    cmyk: '92 / 59 / 0 / 0',
    pantone: '2727 C'
  },
  NAVY: {
    name: 'navy',
    textColor: 'gray',
    hex: '#0B2449',
    rgb: '11 / 36 / 73',
    cmyk: '85 / 51 / 0 / 71',
    pantone: '2965 C'
  },
  MIST: {
    name: 'mist',
    textColor: 'navy',
    hex: '#BCD0F5',
    rgb: '188 / 208 / 245',
    cmyk: '23 / 15 / 0 / 4',
    pantone: '545 C'
  },
  SKY: {
    name: 'sky',
    textColor: 'gray',
    hex: '#4F8EFF',
    rgb: '79 / 142 / 255',
    cmyk: '69 / 44 / 0 / 0'
  },
  NAVY_LIGHT: {
    name: 'navy-light',
    textColor: 'gray',
    hex: '#1C4176',
    rgb: '28 / 65 / 118',
    cmyk: '76 / 45 / 0 / 54'
  },
  SKY_LIGHT: {
    name: 'sky-light',
    textColor: 'navy',
    hex: '#89B4FF',
    rgb: '137 / 180 / 255',
    cmyk: '46 / 29 / 0 / 0'
  },
  FROST: {
    name: 'frost',
    textColor: 'blue',
    hex: '#EEEF3FD',
    rgb: '238 / 243 / 253',
    cmyk: '6 / 4 / 0 / 1'
  }
}

const MAIN_COLORS = [COLORS.GRAY, COLORS.BLUE, COLORS.NAVY, COLORS.MIST]
const COLOR_COMBINATIONS = [
  { background: COLORS.NAVY, text: COLORS.BLUE },
  { background: COLORS.BLUE, text: COLORS.GRAY },
  { background: COLORS.MIST, text: COLORS.NAVY },
  { background: COLORS.GRAY, text: COLORS.BLUE },
  { background: COLORS.WHITE, text: COLORS.INK },
  { background: COLORS.SKY, text: COLORS.NAVY_LIGHT },
  { background: COLORS.SKY_LIGHT, text: COLORS.NAVY },
  { background: COLORS.FROST, text: COLORS.INK },
  { background: COLORS.NAVY_LIGHT, text: COLORS.SKY_LIGHT }
]

const asideSections = [
  { id: 'section1', label: pageData.section1.title },
  { id: 'section2', label: pageData.section2.title },
  { id: 'section3', label: pageData.section3.title },
  { id: 'section4', label: pageData.section4.title },
  { id: 'section5', label: pageData.section5.title }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-page-title">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/brand-colors">
    <Section class="pb-8">
      <p class="text-page-description">
        {pageData.pageDescription}
      </p>
    </Section>
    <Section id="section1" class="grid grid-col-4 pb-8">
      {
        MAIN_COLORS.map((color) => (
          <div class={`bg-${color.name}`}>
            <p>{color.hex}</p>
            <p>RGB: {color.rgb}</p>
            <p>CMYK: {color.cmyk}</p>
            <p>PANTONE {color.cmyk}</p>
          </div>
        ))
      }
    </Section>

    <Section id="section2" class="pb-8">
      <!-- <Block5 title={'Tittle'} description={'Description'} medias={[]} /> -->
    </Section>

    <Section class="grid grid-col-4 pb-8">
      {
        Object.values(COLORS).map((color) => (
          <div class={`bg-${color.name}`}>
            <p>{color.hex}</p>
            <p>RGB: {color.rgb}</p>
            <p>CMYK: {color.cmyk}</p>
            {color.pantone && <p>PANTONE: {color.pantone}</p>}
          </div>
        ))
      }
    </Section>

    <!-- <Section class="pb-8">
      <Block5 title={'Tittle'} description={'Description'} medias={[]} />
    </Section> -->

    <!-- <Section id="section4" class="pb-8">
      <Block4 title={'Tittle'} description={'Description'} media={} />
    </Section> -->

    <Section id="section3" class="pb-8">
      <h3>Color combination</h3>
      <div class="grid grid-cols-3 gap-6 row-gap-4">
        {
          COLOR_COMBINATIONS.map((combi) => (
            <div
              class={`flex items-center justify-center bg-${combi.background.name}`}
            >
              <span class={`text-headline-2 text-${combi.text.name}`}>Aa</span>
            </div>
          ))
        }
      </div>
    </Section>

    <Section id="section5" class="pb-12 md:pb-20">
      <Block7
        title={pageData.section5.title}
        description={pageData.section5.description}
        items={pageData.section5.items}
      />
    </Section>
  </PageAsideLayout>
</MainLayout>
