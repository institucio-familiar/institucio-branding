---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { NUESTRA_MARCA_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toMedia } from '@/sanity/lib/utils'
import {
  parsePageHeader,
  toAtom1
} from '@/sanity/lib/page-parsers'
import PageAsideLayout from '@/components/PageAsideLayout.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(NUESTRA_MARCA_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    introMedia: toMedia(sanityPageData?.intro?.media),
    section1: sanityPageData?.section1
      ? {
          title: sanityPageData.section1.title?.[locale],
          questions: (sanityPageData.section1.questions ?? []).map(
            (question) => ({
              question: question.question?.[locale],
              answer: question.answer?.[locale]
            })
          )
        }
      : null,
    section2: (sanityPageData?.section2 ?? [])
      .map((item) => {
        const media = toMedia(item.media)
        if (!media) return null

        return {
          title: item.title?.[locale],
          description: item.description?.[locale],
          media
        }
      })
      .filter(Boolean),
    section3: sanityPageData?.section3
      ? {
          typography: toAtom1(sanityPageData.section3.typography, locale),
          color: toAtom1(sanityPageData.section3.color, locale),
          voz: toAtom1(sanityPageData.section3.voz, locale)
        }
      : null
  }
}

const pageData = await getPageData()

const asideSections = [
  { id: 'section1', label: 'Sección 1' },
  { id: 'section2', label: 'Sección 2' },
  { id: 'section3', label: 'Principios creativos' }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-navy text-headline-1 uppercase py-indent-2">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/nuestra-marca" />
</MainLayout>
