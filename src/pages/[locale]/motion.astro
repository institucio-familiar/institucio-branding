---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { MOTION_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import {
  parsePageHeader,
  toBadUses,
  toMotionSection,
  toSectionWithAtom1Blocks
} from '@/sanity/lib/page-parsers'
import Block7 from '@/components/ui/blocks/Block-7.astro'
import PageAsideLayout from '@/components/PageAsideLayout.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(MOTION_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    section1: toSectionWithAtom1Blocks(sanityPageData?.section1, locale),
    section2: toMotionSection(sanityPageData?.section2, locale),
    section3: toMotionSection(sanityPageData?.section3, locale),
    section4: toMotionSection(sanityPageData?.section4, locale),
    section5: toMotionSection(sanityPageData?.section5, locale),
    section6: toBadUses(sanityPageData?.section6, locale)
  }
}

const pageData = await getPageData()

const asideSections = [
  { id: 'section1', label: 'Sección 1' },
  { id: 'section2', label: 'Animación logotipo' },
  { id: 'section3', label: 'Animación tipográfica' },
  { id: 'section4', label: 'Transiciones' },
  { id: 'section5', label: 'Animaciones UI' },
  { id: 'section6', label: 'Malos usos' }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-navy text-headline-1 uppercase py-indent-2">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/motion">
    <!-- <section id="section6">
      <Block7
        title={pageData.badCases.title}
        description={pageData.description}
        items={pageData.badCases.items}
      />
    </section> -->
  </PageAsideLayout>
</MainLayout>
