---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { TRADEMARKS_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import {
  parsePageHeader,
  toAtom1Array,
  toBadUses,
  toTrademarkSection
} from '@/sanity/lib/page-parsers'
import { slugify } from '@/src/lib/utils'
import PageAsideLayout from '@/layouts/page-aside/PageAsideLayout.astro'
import Section from '@/layouts/page-aside/PageAsideSection.astro'
import Card from '@/components/ui/Card.astro'
import { Block4, Block5, Block7, Block9 } from '@/components/ui/blocks'

const SECTIONS = [
  'section1',
  'section2',
  'section3',
  'section4',
  'section5'
] as const

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(TRADEMARKS_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    introBlocks: toAtom1Array(sanityPageData?.intro?.blocks, locale),
    sections: SECTIONS.map((key) => {
      const data = toTrademarkSection(sanityPageData?.[key], locale)
      return {
        id: slugify(data.title),
        data
      }
    }),
    section6: toBadUses(sanityPageData?.section6, locale)
  }
}

const pageData = await getPageData()

const asideSections = [
  pageData.pageTitle,
  ...pageData.sections.map((section) => section.data.title),
  pageData.section6.title
].map((label) => ({ id: slugify(label), label }))
---

<MainLayout>
  <Hero
    media={pageData.heroMedia}
    mediaMobile={pageData.heroMediaMobile}
    title={pageData.pageTitle}
  />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-page-title">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/trademarks">
    <Section id={asideSections[0].id} class="pb-8">
      <p class="text-page-description">
        {pageData.pageDescription}
      </p>
    </Section>
    {
      pageData.introBlocks && (
        <Section class="pb-12 md:pb-16">
          <div
            class="grid grid-cols-1 gap-8 md:gap-4 md:grid-cols-3"
            data-reveal-in-view
          >
            {pageData.introBlocks?.map(
              (block) =>
                block.media && (
                  <Card
                    title={block.title}
                    description={block.description}
                    media={block.media}
                  />
                )
            )}
          </div>
        </Section>
      )
    }
    {
      pageData.sections.map(
        (section) =>
          section.data.media && (
            <Section id={section.id} class="pb-12 md:pb-16">
              <div class="pb-4 md:pb-8">
                <Block7
                  title={section.data.title}
                  description={section.data.description}
                  media={section.data.media}
                />
              </div>

              {section.data.blocks?.map((block) => {
                if (block.type === 'atom_1' && block.block.media) {
                  return (
                    <div class="pb-4 md:pb-8">
                      <Block4
                        title={block.block.title}
                        description={block.block.description}
                        media={block.block.media}
                      />
                    </div>
                  )
                } else if (block.type === 'atom_2' && block.block.medias) {
                  return (
                    <div class="pb-4 md:pb-8">
                      <Block5
                        title={block.block.title}
                        description={block.block.description}
                        medias={block.block.medias}
                      />
                    </div>
                  )
                }
              })}
            </Section>
          )
      )
    }
    <Section id={asideSections[asideSections.length - 1].id} class="pb-12 md:pb-20">
      <Block9
        title={pageData.section6.title}
        description={pageData.section6.description}
        items={pageData.section6.items}
      />
    </Section>
  </PageAsideLayout>
</MainLayout>
