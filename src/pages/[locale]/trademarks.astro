---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { TRADEMARKS_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import {
  parsePageHeader,
  toAtom1Array,
  toBadUses,
  toTrademarkSection
} from '@/sanity/lib/page-parsers'
// import { Block7 } from '@/components/ui/blocks'
import PageAsideLayout from '@/layouts/page-aside/PageAsideLayout.astro'
import Section from '@/layouts/page-aside/PageAsideSection.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(TRADEMARKS_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    introBlocks: toAtom1Array(sanityPageData?.intro?.blocks, locale),
    section1: toTrademarkSection(sanityPageData?.section1, locale),
    section2: toTrademarkSection(sanityPageData?.section2, locale),
    section3: toTrademarkSection(sanityPageData?.section3, locale),
    section4: toTrademarkSection(sanityPageData?.section4, locale),
    section5: toTrademarkSection(sanityPageData?.section5, locale),
    section6: toBadUses(sanityPageData?.section6, locale)
  }
}

const pageData = await getPageData()

const asideSections = [
  { id: 'section1', label: 'Logotipo' },
  { id: 'section2', label: 'Escudo' },
  { id: 'section3', label: 'Favicon' },
  { id: 'section4', label: 'Otros formatos' },
  { id: 'section5', label: 'Colaboraciones' },
  { id: 'section6', label: 'Malos usos' }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-page-title">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/trademarks">
    <Section class="pb-8">
      <p class="text-page-description">
        {pageData.pageDescription}
      </p>
    </Section>
    <!-- <section id="section6">
      <Block7
        title={pageData.badCases.title}
        description={pageData.description}
        items={pageData.badCases.items}
      />
    </section> -->
  </PageAsideLayout>
</MainLayout>
