---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import Button from '@/components/ui/Button.astro'
import Icon from '@/components/ui/Icon.astro'
import Puncha from '@/components/icons/Puncha.astro'
import MediaAsset from '@/components/MediaAsset.astro'
import Mask from '@/components/ui/Mask.astro'
import Block from '@/components/ui/blocks/Block.astro'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import { TEST_1_QUERY } from '@/sanity/queries/pages'
import { toBlocks } from '@/sanity/lib/page-parsers'
import { toMedia, type SanityBlockData } from '@/sanity/lib/utils'
import { sanityClient } from 'sanity:client'
import PageAsideLayout from '@/components/PageAsideLayout.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(TEST_1_QUERY)

  // Parse data
  const sanityBlocks: SanityBlockData[] = sanityPageData?.blocks ?? []

  return {
    title: sanityPageData?.title,
    slug: sanityPageData?.slug?.current,
    description: sanityPageData?.description,
    heroMedia: toMedia(sanityPageData?.heroMedia),
    blocks: toBlocks(sanityBlocks as SanityBlockData[])
  }
}

const pageData = await getPageData()
const heroMedia = pageData.heroMedia

const iconVariants = [
  'primary-dark',
  'primary-blue',
  'secondary-white',
  'outline-dark',
  'outline-blue'
] as const

const arrowDirections = ['top', 'left', 'right', 'bottom'] as const

const iconNames = [
  'arrow',
  'check',
  'controls-minus',
  'controls-pause',
  'controls-play',
  'controls-plus',
  'download',
  'cross',
  'hamburger',
  'search'
] as const

const typographyStyles = [
  'text-macro',
  'text-headline-1',
  'text-headline-2',
  'text-headline-3',
  'text-headline-4',
  'text-body',
  'text-body-bold',
  'text-cta',
  'text-micro'
] as const

const maskTypes = [
  { type: '4o', border: true },
  { type: 'tibo' },
  { type: 'tibo_horizontal' },
  { type: 'tobo' },
  { type: 'tobo_horizontal' },
  { type: 'tobobo' }
] as const

const asideSections = [
  { id: 'typography', label: 'Typography' },
  { id: 'ctas', label: 'CTAs' },
  { id: 'icons', label: 'Icons' },
  { id: 'blocks', label: 'Blocks' },
  { id: 'masks', label: 'Masks' }
]
---

<MainLayout>
  <Hero media={heroMedia} title={pageData.title} />

  <PageAsideLayout sections={asideSections} basePath="/library">
    <section
      id="typography"
      class="relative flex flex-col items-center justify-center gap-12 py-10"
    >
      <Puncha
        color="white"
        class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
      />
      <h1 class="text-navy text-headline-1 uppercase text-center">
        {t('test.title')}
      </h1>
      <h2 class="text-navy text-headline-2 text-center">Typography</h2>
      <div class="flex flex-col gap-10">
        {
          typographyStyles.map((style) => (
            <div class="flex flex-col gap-2 border-b border-navy-light/20 pb-10 last:border-b-0 last:pb-0">
              <p class="text-navy text-micro uppercase">{style}</p>
              <p class={`text-navy ${style}`}>Abc</p>
            </div>
          ))
        }
      </div>
    </section>

    <section
      id="ctas"
      class="flex items-center justify-center flex-col gap-12 py-10 border-t border-navy-light"
    >
    <h2 class="text-navy text-headline-2 text-center">CTAs</h2>
    <div class="flex flex-wrap items-center justify-center gap-6">
      <Button variant="primary-dark">Seguir leyendo</Button>
      <Button variant="primary-blue">Seguir leyendo</Button>
      <Button variant="secondary-white">Seguir leyendo</Button>
      <Button variant="outline-dark">Seguir leyendo</Button>
      <Button variant="outline-blue">Seguir leyendo</Button>
    </div>
  </section>

  <section
      id="icons"
      class="flex items-center justify-center flex-col gap-12 py-10 border-t border-navy-light"
    >
    <h2 class="text-navy text-headline-2 text-center">Icons</h2>
    <div class="flex w-full max-w-4xl flex-col items-center gap-4">
      <p class="text-navy text-small uppercase">number</p>
      <div class="flex flex-wrap items-center justify-center gap-6">
        {
          iconVariants.map((variant) => (
            <Icon name="number" number="01" variant={variant} />
          ))
        }
      </div>
    </div>
    {
      iconNames.map((iconName) =>
        iconName === 'arrow' ? (
          arrowDirections.map((direction) => (
            <div class="flex w-full max-w-4xl flex-col items-center gap-4">
              <p class="text-navy text-small uppercase">
                {iconName} — {direction}
              </p>
              <div class="flex flex-wrap items-center justify-center gap-6">
                {iconVariants.map((variant) => (
                  <Icon name="arrow" variant={variant} direction={direction} />
                ))}
              </div>
            </div>
          ))
        ) : (
          <div class="flex w-full max-w-4xl flex-col items-center gap-4">
            <p class="text-navy text-small uppercase">{iconName}</p>
            <div class="flex flex-wrap items-center justify-center gap-6">
              {iconVariants.map((variant) => (
                <Icon name={iconName} variant={variant} />
              ))}
            </div>
          </div>
        )
      )
    }
  </section>

  {
      pageData.blocks.length ? (
        <section
          id="blocks"
          class="flex flex-col gap-indent py-10 border-t border-navy-light"
        >
        <p class="text-ink text-headline-3">Blocks</p>
        {pageData.blocks.map((block) => (
          <Block {...block} />
        ))}
      </section>
    ) : null
  }

  {
      heroMedia && (
        <section
          id="masks"
          class="grid w-full grid-cols-1 gap-indent border-t border-navy-light py-10 md:grid-cols-2 md:py-20"
        >
        {maskTypes.map((mask) => (
          <Mask
            type={mask.type}
            border={'border' in mask ? mask.border : undefined}
          >
            <MediaAsset
              media={heroMedia}
              title={pageData.title ?? 'Hero media'}
            />
          </Mask>
        ))}
      </section>
    )
  }
  </PageAsideLayout>

  <section
    class="relative flex items-center justify-center bg-white border-t border-navy-light py-10 md:py-20 min-h-[60vh]"
  >
    <p class="text-ink text-headline-3">Final</p>
    <Puncha
      color="white"
      class="absolute bottom-[0.5px] left-1/2 -translate-x-1/2 translate-y-full rotate-180"
    />
  </section>
</MainLayout>
