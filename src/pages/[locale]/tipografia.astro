---
import Layout from '@/layouts/Layout.astro'
import MediaAsset from '@/components/MediaAsset.astro'
import Icon from '@/components/ui/Icon.astro'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import Puncha from '@/components/icons/Puncha.astro'
import { TIPOGRAFIA_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toMedia } from '@/sanity/lib/utils'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(TIPOGRAFIA_PAGE_QUERY)

  // Parse data
  return {
    heroMedia: toMedia(sanityPageData?.hero?.media)
  }
}

const { heroMedia } = await getPageData()

const pageTitle = t('tipografia.title')
---

<Layout>
  <section
    class="flex min-h-screen items-end justify-left bg-mist px-indent py-15 relative"
  >
    <div class="flex flex-col z-2">
      <h1 class="text-white text-headline-2 uppercase">
        {pageTitle}
      </h1>
      <div class="flex items-center gap-2">
        <p class="text-white text-body">{t('hero.scroll-down')}</p>
        <Icon
          id="scroll-to-bottom-icon"
          name="arrow"
          direction="bottom"
          variant="outline-white"
        />
      </div>
    </div>

    {
      heroMedia && (
        <MediaAsset
          media={heroMedia}
          title={pageTitle}
          class="absolute inset-0"
        />
      )
    }
  </section>

  <section
    class="relative flex min-h-screen items-center justify-center bg-white p-20"
  >
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <p class="text-navy text-headline-1 uppercase text-center">
      {t('tipografia.description')}
    </p>
  </section>
</Layout>
