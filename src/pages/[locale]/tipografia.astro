---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { TIPOGRAFIA_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import {
  parsePageHeader,
  toAtom2,
  toBadUses,
  toSectionWithAtom2Blocks
} from '@/sanity/lib/page-parsers'
// import Block7 from '@/components/ui/blocks/Block-7.astro'
import PageAsideLayout from '@/components/PageAsideLayout.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(TIPOGRAFIA_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    section1: sanityPageData?.section1
      ? {
          title: sanityPageData.section1.title?.[locale],
          alverata: sanityPageData.section1.alverata
            ? {
                testText: sanityPageData.section1.alverata.testText?.[locale],
                downloadUrl: sanityPageData.section1.alverata.downloadUrl
              }
            : null,
          inter: sanityPageData.section1.inter
            ? {
                testText: sanityPageData.section1.inter.testText?.[locale],
                downloadUrl: sanityPageData.section1.inter.downloadUrl
              }
            : null
        }
      : null,
    section2: sanityPageData?.section2
      ? {
          title: sanityPageData.section2.title?.[locale],
          description: sanityPageData.section2.description?.[locale],
          titulares: sanityPageData.section2.titulares
            ? {
                title: sanityPageData.section2.titulares.title?.[locale],
                description:
                  sanityPageData.section2.titulares.description?.[locale]
              }
            : null,
          configuration: sanityPageData.section2.configuration
            ? {
                title: sanityPageData.section2.configuration.title?.[locale],
                content: toAtom2(
                  sanityPageData.section2.configuration.content,
                  locale
                )
              }
            : null,
          usage: toAtom2(sanityPageData.section2.usage, locale)
        }
      : null,
    section3: toSectionWithAtom2Blocks(sanityPageData?.section3, locale),
    section4: toSectionWithAtom2Blocks(sanityPageData?.section4, locale),
    section5: toBadUses(sanityPageData?.section5, locale)
  }
}

const pageData = await getPageData()

const asideSections = [
  { id: 'section1', label: 'Sección 1' },
  { id: 'section2', label: 'Sección 2' },
  { id: 'section3', label: 'Sección 3' },
  { id: 'section4', label: 'Sección 4' },
  { id: 'section5', label: 'Malos usos' }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-navy text-headline-1 uppercase py-indent-2">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/tipografia">
    <!-- <section id="section5">
      <Block7
        title={pageData.badCases.title}
        description={pageData.description}
        items={pageData.badCases.items}
      />
    </section> -->
  </PageAsideLayout>
</MainLayout>
