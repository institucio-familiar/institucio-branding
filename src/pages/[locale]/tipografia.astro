---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import { useTranslations } from '@/i18n/ui'
import Puncha from '@/components/icons/Puncha.astro'
import { TIPOGRAFIA_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import {
  parsePageHeader,
  toAtom2,
  toBadUses,
  toSectionWithAtom2Blocks
} from '@/sanity/lib/page-parsers'
import { Block9, Block5, Block8 } from '@/components/ui/blocks'
import PageAsideLayout from '@/layouts/page-aside/PageAsideLayout.astro'
import Section from '@/layouts/page-aside/PageAsideSection.astro'
import { toLocaleString } from '@/sanity/lib/page-parsers'
import Button from '@/components/ui/Button.astro'
import FontPreview from '@/components/FontPreview.astro'
import TypographyScalePreview from '@/components/TypographyScalePreview.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)
const t = useTranslations(locale)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(TIPOGRAFIA_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    section1: sanityPageData?.section1
      ? {
          title: toLocaleString(sanityPageData.section1.title, locale),
          alverata: sanityPageData.section1.alverata
            ? {
                testText: sanityPageData.section1.alverata.testText?.[locale],
                downloadUrl: sanityPageData.section1.alverata.downloadUrl
              }
            : null,
          inter: sanityPageData.section1.inter
            ? {
                testText: sanityPageData.section1.inter.testText?.[locale],
                downloadUrl: sanityPageData.section1.inter.downloadUrl
              }
            : null
        }
      : {
          title: '',
          alverata: null,
          inter: null
        },
    section2: sanityPageData?.section2
      ? {
          title: toLocaleString(sanityPageData.section2.title, locale),
          description: sanityPageData.section2.description?.[locale],
          titulares: sanityPageData.section2.titulares
            ? {
                title: sanityPageData.section2.titulares.title?.[locale],
                description:
                  sanityPageData.section2.titulares.description?.[locale]
              }
            : { title: '', description: '' },
          configuration: sanityPageData.section2.configuration
            ? {
                title: toLocaleString(
                  sanityPageData.section2.configuration.title,
                  locale
                ),
                content: toAtom2(
                  sanityPageData.section2.configuration.content,
                  locale
                )
              }
            : {
                title: '',
                content: { title: '', description: '', medias: [] }
              },
          usage: toAtom2(sanityPageData.section2.usage, locale)
        }
      : {
          title: '',
          description: '',
          titulares: null,
          configuration: null,
          usage: null
        },
    section3: toSectionWithAtom2Blocks(sanityPageData?.section3, locale),
    section4: toSectionWithAtom2Blocks(sanityPageData?.section4, locale),
    section5: toBadUses(sanityPageData?.section5, locale)
  }
}

const pageData = await getPageData()

const asideSections = [
  { id: 'title', label: pageData.pageTitle },
  { id: 'section2', label: t('tipografia.aside.section2') },
  { id: 'section3', label: t('tipografia.aside.section3') },
  { id: 'section4', label: t('tipografia.aside.section4') },
  { id: 'section5', label: pageData.section5.title }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 id="title" class="text-page-title">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/tipografia">
    <Section class="pb-20 md:pb-32">
      <p class="text-page-description">
        {pageData.pageDescription}
      </p>
    </Section>
    <Section id="section1" class="pb-12 md:pb-20">
      <h2 class="text-headline-2 uppercase">
        {pageData.section1.title}
      </h2>
      <div class="flex flex-col gap-16 pt-10 md:gap-24 md:pt-14">
        {
          pageData.section1.alverata && (
            <FontPreview
              name="Alverata"
              fontFamily="serif"
              testText={pageData.section1.alverata.testText ?? ''}
              downloadUrl={pageData.section1.alverata.downloadUrl ?? ''}
              downloadLabel={t('tipografia.download.alverata')}
              regularLabel={t('tipografia.weight.regular')}
              boldLabel={t('tipografia.weight.semibold')}
              sizeLabel={t('tipografia.size')}
            />
          )
        }
        {
          pageData.section1.inter && (
            <FontPreview
              name="Inter"
              fontFamily="sans"
              testText={pageData.section1.inter.testText ?? ''}
              downloadUrl={pageData.section1.inter.downloadUrl ?? ''}
              downloadLabel={t('tipografia.download.inter')}
              regularLabel={t('tipografia.weight.regular')}
              boldLabel={t('tipografia.weight.semibold')}
              sizeLabel={t('tipografia.size')}
            />
          )
        }
      </div>
    </Section>
    <Section id="section2">
      <h2 class="text-headline-2 uppercase leading-[1.2]">
        {pageData.section2.title}
      </h2>
      <p class="text-body pt-6 pb-8 max-w-4xl">
        {pageData.section2.description}
      </p>
    </Section>
    <Section class="py-16 md:py-32" backgroundColor="bg-blue">
      <h2 class="text-headline-2 uppercase text-white">
        {pageData.section2.titulares?.title}
      </h2>
      <p class="text-body pt-8 pb-10 max-w-4xl md:max-w-[40%] text-white">
        {pageData.section2.titulares?.description}
      </p>
      <div class="flex gap-4">
        <Button
          href={pageData.section1.inter?.downloadUrl ?? ''}
          variant="primary-dark"
          icon="download">{t('tipografia.download.inter')}</Button
        >
        <Button
          href={pageData.section1.alverata?.downloadUrl ?? ''}
          variant="secondary-white"
          icon="download">{t('tipografia.download.alverata')}</Button
        >
      </div>
    </Section>
    <Section class="py-16 md:pb-32">
      <TypographyScalePreview />
    </Section>
    <Section class="pb-12 md:pb-20">
      {
        pageData.section2.configuration && (
          <Block5
            bigTitle={pageData.section2.configuration.title}
            title={pageData.section2.configuration.content.title}
            description={pageData.section2.configuration.content.description}
            medias={pageData.section2.configuration.content.medias}
          />
        )
      }
    </Section>
    <Section class="pb-12 md:pb-28">
      {
        pageData.section2.usage && (
          <Block8
            titleSize="text-headline-3"
            title={pageData.section2.usage.title}
            description={pageData.section2.usage.description}
            medias={pageData.section2.usage.medias}
          />
        )
      }
    </Section>
    <Section id="section3" class="pb-16 md:pb-28">
      <h2 class="text-headline-2 uppercase">
        {pageData.section3.title}
      </h2>
      <p class="text-body pt-6 pb-16 md:pt-8 max-w-4xl">
        {pageData.section3.description}
      </p>
      <div class="flex flex-col gap-8 md:gap-16" data-reveal-in-view>
        {
          pageData.section3.blocks &&
            pageData.section3.blocks.map((block) => (
              <Block8
                titleSize="text-headline-3"
                title={block.title}
                description={block.description}
                medias={block.medias}
              />
            ))
        }
      </div>
    </Section>
    <Section id="section4" class="pb-16 md:pb-28">
      <h2 class="text-headline-2 uppercase">
        {pageData.section4.title}
      </h2>
      <p class="text-body pt-6 pb-10 md:pt-8 max-w-4xl">
        {pageData.section4.description}
      </p>
      <div class="flex flex-col gap-8 md:gap-16" data-reveal-in-view>
        {
          pageData.section4.blocks &&
            pageData.section4.blocks.map((block) => (
              <Block5
                title={block.title}
                description={block.description}
                medias={block.medias}
              />
            ))
        }
      </div>
    </Section>
    <Section id="section5" class="pb-12 md:pb-20">
      <Block9
        title={pageData.section5.title}
        description={pageData.section5.description}
        items={pageData.section5.items}
      />
    </Section>
  </PageAsideLayout>
</MainLayout>
