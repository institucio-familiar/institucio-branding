---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { LAYOUT_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toMedia } from '@/sanity/lib/utils'
import {
  parsePageHeader,
  toAtom1,
  toAtom2,
  toBadUses
} from '@/sanity/lib/page-parsers'
import Block7 from '@/components/ui/blocks/Block-7.astro'
import PageAsideLayout from '@/components/PageAsideLayout.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(LAYOUT_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    introOverview: toAtom1(sanityPageData?.intro?.overview, locale),
    section1: sanityPageData?.section1
      ? {
          title: sanityPageData.section1.title?.[locale],
          description: sanityPageData.section1.description?.[locale],
          configuration: toAtom2(sanityPageData.section1.configuration, locale)
        }
      : null,
    section2: sanityPageData?.section2
      ? {
          title: sanityPageData.section2.title?.[locale],
          description: sanityPageData.section2.description?.[locale],
          mediaAsset: toMedia(sanityPageData.section2.mediaAsset),
          formats: (sanityPageData.section2.formats ?? [])
            .map(
              (format: {
                title?: Record<string, string>
                description?: Record<string, string>
                image1?: Parameters<typeof toMedia>[0]
                image2?: Parameters<typeof toMedia>[0]
              }) => {
                const image1 = toMedia(format.image1)
                const image2 = toMedia(format.image2)
                if (!image1 || !image2) return null

                return {
                  title: format.title?.[locale],
                  description: format.description?.[locale],
                  image1,
                  image2
                }
              }
            )
            .filter(Boolean)
        }
      : null,
    section3: toAtom1(sanityPageData?.section3, locale),
    section4: toBadUses(sanityPageData?.section4, locale)
  }
}

const pageData = await getPageData()

const asideSections = [
  { id: 'section1', label: 'Sección 1' },
  { id: 'section2', label: 'Sección 2' },
  { id: 'section3', label: 'Sección 3' },
  { id: 'section4', label: 'Malos usos' }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-navy text-headline-1 uppercase py-indent-2">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/layout">
    <!-- <section id="section4">
      <Block7
        title={pageData.badCases.title}
        description={pageData.description}
        items={pageData.badCases.items}
      />
    </section> -->
  </PageAsideLayout>
</MainLayout>
