---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { LAYOUT_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toMedia } from '@/sanity/lib/utils'
import {
  parsePageHeader,
  toAtom1,
  toAtom2,
  toBadUses
} from '@/sanity/lib/page-parsers'
import { Block1, Block5, Block7, Block9, Block10 } from '@/components/ui/blocks'
import PageAsideLayout from '@/layouts/page-aside/PageAsideLayout.astro'
import Section from '@/layouts/page-aside/PageAsideSection.astro'
import { toLocaleString } from '@/sanity/lib/page-parsers'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(LAYOUT_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    introOverview: toAtom1(sanityPageData?.intro?.overview, locale),
    section1: sanityPageData?.section1
      ? {
          title: toLocaleString(sanityPageData.section1.title, locale),
          description: sanityPageData.section1.description?.[locale],
          configuration: toAtom2(sanityPageData.section1.configuration, locale)
        }
      : {
          title: '',
          description: '',
          configuration: { title: '', description: '', medias: [] }
        },
    section2: sanityPageData?.section2
      ? {
          title: toLocaleString(sanityPageData.section2.title, locale),
          description: sanityPageData.section2.description?.[locale] || '',
          mediaAsset: toMedia(sanityPageData.section2.mediaAsset),
          formats: (sanityPageData.section2.formats ?? [])
            .map((format) => {
              const image1 = toMedia(format.image1)
              const image2 = toMedia(format.image2)
              if (!image1 || !image2) return null

              return {
                title: toLocaleString(format.title, locale),
                description: format.description?.[locale] || '',
                image1,
                image2
              }
            })
            .filter(Boolean)
            .filter((format) => format !== null)
        }
      : {
          title: '',
          description: '',
          mediaAsset: null,
          formats: []
        },
    section3: toAtom1(sanityPageData?.section3, locale) || {
      title: '',
      description: '',
      media: null
    },
    section4: toBadUses(sanityPageData?.section4, locale)
  }
}

const pageData = await getPageData()

const asideSections = [
  { id: 'title', label: pageData.pageTitle },
  { id: 'section1', label: pageData.section1.title },
  { id: 'section2', label: pageData.section2.title },
  { id: 'section3', label: pageData.section3?.title || '' }, // TESTINGAL > Avoid this from being null
  { id: 'section4', label: pageData.section4.title }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 id="title" class="text-page-title">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/layout">
    <Section class="pb-16">
      <p class="text-page-description">
        {pageData.pageDescription}
      </p>
    </Section>
    {
      pageData.introOverview && pageData.introOverview.media && (
        <Section class="pb-16 md:pb-28">
          <h3 class="text-headline-3">{pageData.introOverview.title}</h3>
          <p class="text-body pt-2 pb-6 md:pt-4 md:pb-8 max-w-4xl">
            {pageData.introOverview.description}
          </p>
          <Block1 media1={pageData.introOverview.media} />
        </Section>
      )
    }
    {
      pageData.section1 && (
        <Section id="section1" class="pb-16 md:pb-28">
          <h3 class="text-headline-2 uppercase">{pageData.section1.title}</h3>
          <p class="text-body pt-2 pb-6 md:pt-4 md:pb-8 max-w-4xl">
            {pageData.section1.description}
          </p>
          <Block5
            title={pageData.section1.configuration?.title}
            description={pageData.section1.configuration?.description}
            medias={pageData.section1.configuration?.medias}
          />
        </Section>
      )
    }
    {
      pageData.section2 && pageData.section2.mediaAsset && (
        <Section id="section2" class="pb-16 md:pb-28">
          <Block7
            title={pageData.section2.title}
            description={pageData.section2.description}
            media={pageData.section2.mediaAsset}
          />
          <div class="mt-8" />
          {pageData.section2.formats &&
            pageData.section2.formats.length > 0 && (
              <div class="flex flex-col gap-8 md:gap-16">
                {pageData.section2.formats.map((format) => (
                  <Block10
                    title={format.title}
                    description={format.description}
                    media1={format.image1}
                    media2={format.image2}
                  />
                ))}
              </div>
            )}
        </Section>
      )
    }

    {
      pageData.section3 && pageData.section3.media && (
        <Section id="section3" class="pb-16 md:pb-28">
          <Block7
            title={pageData.section3.title}
            description={pageData.section3.description}
            media={pageData.section3.media}
          />
        </Section>
      )
    }
    <Section id="section4" class="pb-12 md:pb-20">
      <Block9
        title={pageData.section4.title}
        description={pageData.section4.description}
        items={pageData.section4.items}
      />
    </Section>
  </PageAsideLayout>
</MainLayout>
