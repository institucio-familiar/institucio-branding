---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { FOTOGRAFIA_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toMedia } from '@/sanity/lib/utils'
import {
  parsePageHeader,
  toAtom1Array,
  toBadUses
} from '@/sanity/lib/page-parsers'
import { Block8 } from '@/components/ui/blocks'
import PageAsideLayout from '@/layouts/page-aside/PageAsideLayout.astro'
import Section from '@/layouts/page-aside/PageAsideSection.astro'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(FOTOGRAFIA_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    introMedia: toMedia(sanityPageData?.intro?.media),
    section1: toAtom1Array(sanityPageData?.section1, locale),
    section2: toBadUses(sanityPageData?.section2, locale)
  }
}

const pageData = await getPageData()

const asideSections = [
  { id: 'section1', label: 'Sección 1' },
  { id: 'section2', label: 'Malos usos' }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-page-title">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/fotografia">
    <Section class="pb-8">
      <p class="text-page-description">
        {pageData.pageDescription}
      </p>
    </Section>
    <Section id="section2" class="pb-12 md:pb-20">
      <Block8
        title={pageData.section2.title}
        description={pageData.section2.description}
        items={pageData.section2.items}
      />
    </Section>
  </PageAsideLayout>
</MainLayout>
