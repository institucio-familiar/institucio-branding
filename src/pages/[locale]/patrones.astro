---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { PATRONES_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toMedia } from '@/sanity/lib/utils'
import {
  parsePageHeader,
  // toAtom1,
  toAtom1Array,
  toAtom2,
  toBadUses,
  toSectionWithAtom1Blocks,
  toSectionWithAtom2Blocks
} from '@/sanity/lib/page-parsers'
import { Block8 } from '@/components/ui/blocks'
import PageAsideLayout from '@/layouts/page-aside/PageAsideLayout.astro'
import Section from '@/layouts/page-aside/PageAsideSection.astro'
import { toLocaleString } from '@/sanity/lib/page-parsers'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(PATRONES_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    introMedia: toMedia(sanityPageData?.intro?.media),
    section1: toSectionWithAtom1Blocks(sanityPageData?.section1, locale),
    section2: toAtom2(sanityPageData?.section2, locale),
    section3: toSectionWithAtom2Blocks(sanityPageData?.section3, locale),
    section4: sanityPageData?.section4
      ? {
          title: toLocaleString(sanityPageData.section4.title, locale),
          description: sanityPageData.section4.description?.[locale],
          media: toMedia(sanityPageData.section4.media),
          blocks: toAtom1Array(sanityPageData.section4.blocks, locale)
        }
      : {
          title: '',
          description: '',
          media: null,
          blocks: []
        },
    section5: sanityPageData?.section5
      ? {
          title: toLocaleString(sanityPageData.section5.title, locale),
          description: sanityPageData.section5.description?.[locale]
        }
      : {
          title: '',
          description: ''
        },
    section6: toBadUses(sanityPageData?.section6, locale)
  }
}

const pageData = await getPageData()

const asideSections = [
  { id: 'section1', label: pageData.section1.title },
  { id: 'section2', label: pageData.section2.title },
  { id: 'section3', label: pageData.section3.title },
  { id: 'section4', label: pageData.section4.title },
  { id: 'section5', label: pageData.section5.title },
  { id: 'section6', label: pageData.section6.title }
]
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 class="text-page-title">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/patrones">
    <Section class="pb-8">
      <p class="text-page-description">
        {pageData.pageDescription}
      </p>
    </Section>
    <Section id="section6" class="pb-12 md:pb-20">
      <Block8
        title={pageData.section6.title}
        description={pageData.section6.description}
        items={pageData.section6.items}
      />
    </Section>
  </PageAsideLayout>
</MainLayout>
