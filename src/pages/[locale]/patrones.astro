---
import MainLayout from '@/layouts/MainLayout.astro'
import Hero from '@/components/Hero.astro'
import { getPageLocale } from '@/i18n/utils'
import Puncha from '@/components/icons/Puncha.astro'
import { PATRONES_PAGE_QUERY } from '@/sanity/queries/pages'
import { sanityClient } from 'sanity:client'
import { toMedia } from '@/sanity/lib/utils'
import { slugify } from '@/src/lib/utils'
import {
  parsePageHeader,
  toAtom1Array,
  toAtom2,
  toBadUses,
  toSectionWithAtom1Blocks,
  toSectionWithAtom2Blocks
} from '@/sanity/lib/page-parsers'
import { Block1, Block4, Block5, Block8, Block9 } from '@/components/ui/blocks'
import PageAsideLayout from '@/layouts/page-aside/PageAsideLayout.astro'
import Section from '@/layouts/page-aside/PageAsideSection.astro'
import { toLocaleString } from '@/sanity/lib/page-parsers'
import MediaAsset from '@/components/MediaAsset.astro'
import Mask from '@/components/ui/Mask.astro'
import textMask4 from '@/assets/svgs/text_mask_4.svg'

const { locale: localeParam } = Astro.params
const locale = getPageLocale(Astro.currentLocale, localeParam)

async function getPageData() {
  const sanityPageData = await sanityClient.fetch(PATRONES_PAGE_QUERY)

  return {
    ...parsePageHeader(sanityPageData, locale),
    introMedia: toMedia(sanityPageData?.intro?.media),
    section1: toSectionWithAtom1Blocks(sanityPageData?.section1, locale),
    section2: toAtom2(sanityPageData?.section2, locale),
    section3: toSectionWithAtom2Blocks(sanityPageData?.section3, locale),
    section4: sanityPageData?.section4
      ? {
          title: toLocaleString(sanityPageData.section4.title, locale),
          description: sanityPageData.section4.description?.[locale],
          media: toMedia(sanityPageData.section4.media),
          blocks: toAtom1Array(sanityPageData.section4.blocks, locale)
        }
      : {
          title: '',
          description: '',
          media: null,
          blocks: []
        },
    section5: sanityPageData?.section5
      ? {
          title: toLocaleString(sanityPageData.section5.title, locale),
          description: sanityPageData.section5.description?.[locale]
        }
      : {
          title: '',
          description: ''
        },
    section6: toBadUses(sanityPageData?.section6, locale)
  }
}

const pageData = await getPageData()

const asideSections = [
  pageData.pageTitle,
  pageData.section1.title,
  pageData.section2.title,
  pageData.section3.title,
  pageData.section4.title,
  pageData.section5.title,
  pageData.section6.title
].map((label) => ({ id: slugify(label), label }))
---

<MainLayout>
  <Hero media={pageData.heroMedia} title={pageData.pageTitle} />

  <section class="relative bg-white px-indent">
    <Puncha
      color="white"
      class="absolute top-[0.5px] left-1/2 -translate-x-1/2 -translate-y-full"
    />
    <h1 id={asideSections[0].id} class="text-page-title">
      {pageData.pageTitle}
    </h1>
  </section>

  <PageAsideLayout sections={asideSections} basePath="/patrones">
    <Section class="pb-8">
      <p class="text-page-description">
        {pageData.pageDescription}
      </p>
    </Section>
    {
      pageData.introMedia && (
        <Section class="pb-16 md:pb-28">
          <Block1 media1={pageData.introMedia} />
        </Section>
      )
    }
    {
      pageData.section1 && (
        <Section id={asideSections[1].id} class="pb-16 md:pb-28">
          <h3 class="text-headline-2 uppercase">{pageData.section1.title}</h3>
          <p class="text-body pt-2 pb-6 md:pt-4 md:pb-8 max-w-4xl">
            {pageData.section1.description}
          </p>
          <div class="flex flex-col gap-4 md:gap-8">
            {pageData.section1.blocks?.map(
              (block) =>
                block.media && (
                  <Block4
                    title={block.title}
                    description={block.description}
                    media={block.media}
                  />
                )
            )}
          </div>
        </Section>
      )
    }
    {
      pageData.section2 && (
        <Section id={asideSections[2].id} class="pb-16 md:pb-28">
          <Block8
            titleSize="text-headline-2 uppercase"
            title={pageData.section2.title}
            description={pageData.section2.description}
            medias={pageData.section2.medias}
          />
        </Section>
      )
    }
    {
      pageData.section3 && (
        <Section id={asideSections[3].id} class="pb-16 md:pb-28">
          <h3 class="text-headline-2 uppercase">{pageData.section3.title}</h3>
          <p class="text-body pt-2 pb-6 md:pt-4 md:pb-8 max-w-4xl">
            {pageData.section3.description}
          </p>
          <div class="flex flex-col gap-4 md:gap-8" data-reveal-in-view>
            {pageData.section3.blocks?.map((block) => (
              <Block5
                title={block.title}
                description={block.description}
                medias={block.medias}
              />
            ))}
          </div>
        </Section>
      )
    }
    {
      pageData.section4 && (
        <Section id={asideSections[4].id} class="pb-16 md:pb-28">
          <h3 class="text-headline-2 uppercase">{pageData.section4.title}</h3>
          <p class="text-body pt-2 pb-6 md:pt-4 md:pb-8 max-w-4xl">
            {pageData.section4.description}
          </p>
          {pageData.section4.media && (
            <Block1 media1={pageData.section4.media} />
          )}
          <div class="mt-4 md:mt-8" />
          <div class="flex flex-col gap-4 md:gap-8" data-reveal-in-view>
            {pageData.section4.blocks?.map(
              (block) =>
                block.media && (
                  <Block4
                    title={block.title}
                    description={block.description}
                    media={block.media}
                  />
                )
            )}
          </div>
        </Section>
      )
    }
    {
      pageData.section5 && (
        <Section id={asideSections[5].id} class="pb-8">
          <h3 class="text-headline-2 uppercase">{pageData.section5.title}</h3>
          <p class="text-body pt-2 pb-6 md:pt-4 md:pb-8 max-w-4xl">
            {pageData.section5.description}
          </p>
        </Section>
      )
    }
    <Section class="pb-16 md:pb-28">
      <div
        class="flex flex-col text-[10vw] lg:text-[8vw] font-serif font-semibold uppercase"
      >
        <div class="flex flex-row gap-4 md:gap-6">
          <p>Per un camí</p>
          <Mask
            type="tibo_horizontal"
            class="w-[13vw] shrink-0 lg:w-[11vw] translate-y-[-0.5vw]"
          >
            <MediaAsset
              media={{
                mediaType: 'video',
                playbackId: 'w1AiO61GLM9yZWVlvBtoDZZoqsE299slTkUfWMcXCw00'
              }}
            />
          </Mask>
        </div>
        <div class="flex flex-row gap-4 md:gap-6">
          <p>que</p>
          <Mask
            type="4o"
            class="w-[9vw] shrink-0 lg:w-[7vw] translate-y-[-6px]"
          >
            <img
              src="https://cdn.sanity.io/images/ryub47of/production/f4ce79b920f9e4ed92beb72d82738b0f29bffc16-1728x2424.png?w=300"
              alt="ens porta"
            />
          </Mask>
          <p>ens porta</p>
        </div>
        <div class="flex flex-row gap-2">
          <p>ben lluny</p>
          <div class="relative w-full max-w-[11vw] lg:max-w-[9vw]">
            <img
              src="https://cdn.sanity.io/images/ryub47of/production/bd1225fc754aae5d9278ff44668adf3ec4e6afb1-2048x2080.png?w=300"
              alt="ens porta"
              class="absolute top-0 left-0 w-full max-w-[11vw] lg:max-w-[9vw] translate-y-[-1.5vw] rotate-25"
            />
          </div>
          <p>la</p>
        </div>
        <div class="flex flex-row gap-2">
          <p>nostra guía</p>
          <img
            src={textMask4.src}
            alt="ens porta"
            class="w-full max-w-[6vw] lg:max-w-[5vw] translate-y-[-0.5vw]"
          />
          <p>és</p>
        </div>
        <div class="flex flex-row relative w-fit">
          <p>la llum</p>
          <img
            src="https://cdn.sanity.io/images/ryub47of/production/3508dd5abbd012e3411d83889b23af4e3af43497-1856x2304.png?w=300"
            alt="ens porta"
            class="w-full absolute top-[-4vw] right-[-10vw] lg:right-[-8vw] max-w-[12vw] lg:max-w-[10vw]"
          />
        </div>
      </div>
    </Section>
    <Section id={asideSections[6].id} class="pb-12 md:pb-20">
      <Block9
        title={pageData.section6.title}
        description={pageData.section6.description}
        items={pageData.section6.items}
      />
    </Section>
  </PageAsideLayout>
</MainLayout>
