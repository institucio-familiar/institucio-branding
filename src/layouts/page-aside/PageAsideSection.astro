---
import type { HTMLAttributes } from 'astro/types'
import {
  PAGE_ASIDE_CONTENT,
  PAGE_ASIDE_GRID
} from '@/layouts/page-aside/page-aside-grid'

type Props = HTMLAttributes<'section'> & {
  backgroundColor?: string
}

const { class: className, backgroundColor, ...rest } = Astro.props
---

<section data-page-aside-section {...rest} class={backgroundColor}>
  <div class={PAGE_ASIDE_GRID}>
    <div class={PAGE_ASIDE_CONTENT} data-page-aside-content>
      <div class={className}>
        <slot />
      </div>
    </div>
  </div>
</section>
