---
import '../styles/global.css'
import Analytics from '@vercel/analytics/astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { htmlLang } from '@/i18n/config'
import { useTranslations } from '@/i18n/ui'
import { getPageLocale } from '@/i18n/utils'

import { Font, type CssVariable } from 'astro:assets'

interface Props {
  title?: string
}

const { title } = Astro.props
const locale = getPageLocale(Astro.currentLocale, Astro.params.locale)
const t = useTranslations(locale)
const pageTitle = title ?? t('site.title')

// Constants
const FONTS: CssVariable[] = ['--custom-font-sans', '--custom-font-serif']
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- <meta name="generator" content={Astro.generator} /> -->

    <!-- <SEO {...seoData} /> -->

    <title>{pageTitle}</title>

    {FONTS.map((font) => <Font cssVariable={font} preload />)}

    <Analytics />
  </head>
  <body>
    <script src="../scripts/app.ts"></script>

    <Header />

    <main id="swup" class="transition-fade">
      <div id="content">
        <slot />
      </div>
    </main>

    <Footer />

    <script>
      import { setViewportSize } from '@/scripts/utils/setViewportSize'
      import { $screenDebounce } from '@/scripts/stores/screen'

      // Set viewport size
      $screenDebounce.subscribe(() => {
        setViewportSize()
      })
    </script>
  </body>
</html>
