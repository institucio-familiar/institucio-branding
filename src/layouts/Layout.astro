---
import '../styles/global.css'
import Analytics from '@vercel/analytics/astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'

import { Font, type CssVariable } from 'astro:assets'

// Constants
const FONTS: CssVariable[] = ['--custom-font-sans', '--custom-font-serif']
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- <meta name="generator" content={Astro.generator} /> -->

    <!-- <SEO {...seoData} /> -->

    <title>Institució Branding</title>

    {FONTS.map((font) => <Font cssVariable={font} preload />)}

    <Analytics />
  </head>
  <body>
    <script src="../scripts/app.ts"></script>

    <Header />

    <main id="swup" class="transition-fade">
      <div id="content">
        <slot />
      </div>
    </main>

    <Footer />

    <script>
      import { setViewportSize } from '@/scripts/utils/setViewportSize'
      import { $screenDebounce } from '@/scripts/stores/screen'

      // Set viewport size
      $screenDebounce.subscribe(() => {
        setViewportSize()
      })
    </script>
  </body>
</html>
